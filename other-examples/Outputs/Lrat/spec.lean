def Lrat.IsWf.Zeros (s : String) : Prop :=
  matchesTerm ((TokClass.asciiRange 48 48 : TokClass)) LenSpec.atLeastOne s

def Lrat.IsWf.NonZero (s : String) : Prop :=
  matchesTerm ((TokClass.asciiRange 49 57 : TokClass)) (LenSpec.exactly 1) s

def Lrat.IsWf.Digits (s : String) : Prop :=
  IsDigits s

def Lrat.IsWf.Pos (s : String) : Prop :=
  (∃ zeros rest,
      s = zeros ++ rest ∧
        Lrat.IsWf.Zeros zeros ∧
          ∃ nonZero rest₁,
            rest = nonZero ++ rest₁ ∧ Lrat.IsWf.NonZero nonZero ∧ (Lrat.IsWf.Digits rest₁ ∨ rest₁ = "")) ∨
    ∃ nonZero rest₁, s = nonZero ++ rest₁ ∧ Lrat.IsWf.NonZero nonZero ∧ (Lrat.IsWf.Digits rest₁ ∨ rest₁ = "")

def Lrat.IsWf.Id (s : String) : Prop :=
  Lrat.IsWf.Pos s

def Lrat.IsWf.DelId (s : String) : Prop :=
  Lrat.IsWf.Pos s

def Lrat.IsWf.DelIds (s : String) : Prop :=
  ∃ delIds,
    s = delIds ++ " " ∧
      ∃ parts : List String,
        1 ≤ parts.length ∧ True ∧ (∀ p ∈ parts, Lrat.IsWf.DelId p) ∧ delIds = String.intercalate " " parts

def Lrat.IsWf.Delete (s : String) : Prop :=
  ∃ rest,
    s = "d " ++ rest ∧ ((∃ delIds rest₁, rest = delIds ++ rest₁ ∧ Lrat.IsWf.DelIds delIds ∧ rest₁ = "0") ∨ rest = "0")

def Lrat.IsWf.Neg (s : String) : Prop :=
  ∃ pos, s = "-" ++ pos ∧ Lrat.IsWf.Pos pos

def Lrat.IsWf.Lit (s : String) : Prop :=
  Lrat.IsWf.Neg s ∨ Lrat.IsWf.Pos s

def Lrat.IsWf.Lits (s : String) : Prop :=
  ∃ lits,
    s = lits ++ " " ∧
      ∃ parts : List String,
        1 ≤ parts.length ∧ True ∧ (∀ p ∈ parts, Lrat.IsWf.Lit p) ∧ lits = String.intercalate " " parts

def Lrat.IsWf.RupHint (s : String) : Prop :=
  Lrat.IsWf.Pos s

def Lrat.IsWf.RupHints (s : String) : Prop :=
  ∃ rupHints,
    s = rupHints ++ " " ∧
      ∃ parts : List String,
        1 ≤ parts.length ∧ True ∧ (∀ p ∈ parts, Lrat.IsWf.RupHint p) ∧ rupHints = String.intercalate " " parts

def Lrat.IsWf.RatPivot (s : String) : Prop :=
  Lrat.IsWf.Neg s

def Lrat.IsWf.RatHint (s : String) : Prop :=
  Lrat.IsWf.Pos s

def Lrat.IsWf.RatHints (s : String) : Prop :=
  ∃ parts : List String, 1 ≤ parts.length ∧ True ∧ (∀ p ∈ parts, Lrat.IsWf.RatHint p) ∧ s = String.intercalate " " parts

def Lrat.IsWf.RatTail (s : String) : Prop :=
  ∃ ratHints, s = " " ++ ratHints ∧ Lrat.IsWf.RatHints ratHints

def Lrat.IsWf.RatStep (s : String) : Prop :=
  ∃ ratPivot rest, s = ratPivot ++ rest ∧ Lrat.IsWf.RatPivot ratPivot ∧ (Lrat.IsWf.RatTail rest ∨ rest = "")

def Lrat.IsWf.RatSteps (s : String) : Prop :=
  ∃ ratSteps,
    s = ratSteps ++ " " ∧
      ∃ parts : List String,
        1 ≤ parts.length ∧ True ∧ (∀ p ∈ parts, Lrat.IsWf.RatStep p) ∧ ratSteps = String.intercalate " " parts

def Lrat.IsWf.Add (s : String) : Prop :=
  (∃ lits rest,
      s = lits ++ rest ∧
        Lrat.IsWf.Lits lits ∧
          ∃ rest₁,
            rest = "0 " ++ rest₁ ∧
              ((∃ rupHints rest₂,
                  rest₁ = rupHints ++ rest₂ ∧
                    Lrat.IsWf.RupHints rupHints ∧
                      ((∃ ratSteps rest₃, rest₂ = ratSteps ++ rest₃ ∧ Lrat.IsWf.RatSteps ratSteps ∧ rest₃ = "0") ∨
                        rest₂ = "0")) ∨
                (∃ ratSteps rest₃, rest₁ = ratSteps ++ rest₃ ∧ Lrat.IsWf.RatSteps ratSteps ∧ rest₃ = "0") ∨
                  rest₁ = "0")) ∨
    ∃ rest₁,
      s = "0 " ++ rest₁ ∧
        ((∃ rupHints rest₂,
            rest₁ = rupHints ++ rest₂ ∧
              Lrat.IsWf.RupHints rupHints ∧
                ((∃ ratSteps rest₃, rest₂ = ratSteps ++ rest₃ ∧ Lrat.IsWf.RatSteps ratSteps ∧ rest₃ = "0") ∨
                  rest₂ = "0")) ∨
          (∃ ratSteps rest₃, rest₁ = ratSteps ++ rest₃ ∧ Lrat.IsWf.RatSteps ratSteps ∧ rest₃ = "0") ∨ rest₁ = "0")

def Lrat.IsWf.Body (s : String) : Prop :=
  Lrat.IsWf.Delete s ∨ Lrat.IsWf.Add s

def Lrat.IsWf.Cr (s : String) : Prop :=
  s = "\x0d" ∨ s = ""

def Lrat.IsWf.Line (s : String) : Prop :=
  ∃ id body cr, ((s = id ++ " " ++ body ++ cr ∧ Lrat.IsWf.Id id) ∧ Lrat.IsWf.Body body) ∧ Lrat.IsWf.Cr cr

def Lrat.Production (s : String) : Prop :=
  ∃ lines,
    s = lines ++ "\n" ∧
      ∃ parts : List String,
        1 ≤ parts.length ∧ True ∧ (∀ p ∈ parts, Lrat.IsWf.Line p) ∧ lines = String.intercalate "\n" parts

abbrev Lrat.IsWf.Proof (s : String) : Prop :=
  Lrat.Production s

def Lrat.value
    (line : List (String × String × List String × List String × List String × List (String × List String))) :=
  toActions line

def Lrat.WfConstraints (line : List (List String × List String)) : Prop :=
  ratNeedsClause line = true

def Lrat.SatisfiesWfConstraints (s : String) : Prop :=
  Lrat.WfConstraints
    (Triptych.componentWith Lrat.grammar s
      (fun m =>
        (Triptych.CaptureMap.groups "Line"
              ["Line", "Id", "Body", "Cr", "Pos", "Delete", "Add", "Zeros", "NonZero", "Digits", "DelIds", "Lits",
                "RupHints", "RatSteps", "DelId", "Lit", "RupHint", "RatStep", "Neg", "RatPivot", "RatTail", "RatHints",
                "RatHint", "DelId#count", "Lit#count", "RupHint#count", "RatStep#count", "RatHint#count"]
              m).map
          fun segment =>
          (Triptych.CaptureMap.toEnvList segment "Lit", Triptych.CaptureMap.toEnvList segment "RatPivot")))

abbrev Lrat.IsWf (s : String) : Prop :=
  Lrat.Production s ∧ Lrat.SatisfiesWfConstraints s

abbrev Lrat.IsValid (s : String) : Prop :=
  Lrat.IsWf s

def Lrat.Denotes (s : String) (a : Array Std.Tactic.BVDecide.LRAT.IntAction) : Prop :=
  Lrat.IsValid s ∧
    a =
      Lrat.value
        (Triptych.componentWith Lrat.grammar s
          (fun m =>
            (Triptych.CaptureMap.groups "Line"
                  ["Line", "Id", "Body", "Cr", "Pos", "Delete", "Add", "Zeros", "NonZero", "Digits", "DelIds", "Lits",
                    "RupHints", "RatSteps", "DelId", "Lit", "RupHint", "RatStep", "Neg", "RatPivot", "RatTail",
                    "RatHints", "RatHint", "DelId#count", "Lit#count", "RupHint#count", "RatStep#count",
                    "RatHint#count"]
                  m).map
              fun segment =>
              ((Triptych.CaptureMap.toEnv segment "Id").getD "",
                ((Triptych.CaptureMap.toEnv segment "Delete").getD "",
                  (Triptych.CaptureMap.toEnvList segment "DelId",
                    (Triptych.CaptureMap.toEnvList segment "Lit",
                      (Triptych.CaptureMap.toEnvList segment "RupHint",
                        (Triptych.CaptureMap.groups "RatStep"
                              ["RatStep", "RatPivot", "RatTail", "Neg", "RatHints", "Pos", "RatHint", "Zeros",
                                "NonZero", "Digits", "RatHint#count"]
                              segment).map
                          fun segment =>
                          ((Triptych.CaptureMap.toEnv segment "RatPivot").getD "",
                            Triptych.CaptureMap.toEnvList segment "RatHint"))))))))

structure Lrat.View where
  input : String
  lineGroups : List (String × String × List String × List String × List String × List (String × List String))
  lineGroups1 : List (List String × List String)

def Lrat.View.WfConstraints (v : Lrat.View) : Prop :=
  Lrat.WfConstraints (Lrat.View.lineGroups1 v)

abbrev Lrat.View.Valid (v : Lrat.View) : Prop :=
  Lrat.View.WfConstraints v

def Lrat.View.denotation (v : Lrat.View) :=
  Lrat.value (Lrat.View.lineGroups v)
