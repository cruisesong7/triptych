      Production.mk "Body" [[SymItem.mk (Sym.ref "Delete") false], [SymItem.mk (Sym.ref "Add") false]],
      Production.mk "Delete"
        [[SymItem.mk (Sym.lit "d ") false, SymItem.mk (Sym.ref "DelIds") true, SymItem.mk (Sym.lit "0") false]],
      Production.mk "DelIds"
        [[SymItem.mk (Sym.rep " " (Sym.ref "DelId") (1 : Nat) (none : Option Nat)) false,
