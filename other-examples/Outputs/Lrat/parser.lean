/- ════════════════════════════ equivalence ════════════════════════════
The auto-discharged guarantees relating the readable surface to the executable
engine: `IsWfGrammar_equiv` proves grammar-layout agreement and `IsWf_equiv`
proves full well-formedness agreement. `computeValue_eq` proves the values agree,
while `decodeView_input`, `IsValid_view`, and `computeValue_view` expose the typed
parse view. Derived `DecidablePred` instances make the surface predicates executable
via the engine. No `sorry`. -/

theorem Lrat.Derivation.Zeros.matches (qual : String) (fuel : Nat) (d : Lrat.Derivation.Zeros)
    (hvalid : Lrat.Derivation.Zeros.Valid d) :
    Triptych.ProdMatch Lrat.grammar qual (fuel + 1)
      (Production.mk "Zeros" [[SymItem.mk (Sym.term (TokClass.asciiRange 48 48) (LenSpec.atLeastOne)) false]])
      (Lrat.Derivation.Zeros.render d) (Lrat.Derivation.Zeros.capturesWith qual d) :=
  by
  cases d with
  | alt0 part0 =>
    simp only [Lrat.Derivation.Zeros.Valid] at hvalid
    have hpart0 := hvalid
    simp only [Lrat.Derivation.Zeros.render, Lrat.Derivation.Zeros.capturesWith]
    apply
      Triptych.prodMatch_of_alt (alt := [SymItem.mk (Sym.term (TokClass.asciiRange 48 48) (LenSpec.atLeastOne)) false])
    · simp
    ·
      exact
        (by
          apply Triptych.seqMatch_required
          ·
            exact
              Triptych.symMatch_term Lrat.grammar qual (fuel + 1) (TokClass.asciiRange 48 48) (LenSpec.atLeastOne) part0
                hpart0
          · exact Triptych.seqMatch_nil Lrat.grammar qual (fuel + 1))

theorem Lrat.Derivation.NonZero.matches (qual : String) (fuel : Nat) (d : Lrat.Derivation.NonZero)
    (hvalid : Lrat.Derivation.NonZero.Valid d) :
    Triptych.ProdMatch Lrat.grammar qual (fuel + 1)
      (Production.mk "NonZero" [[SymItem.mk (Sym.term (TokClass.asciiRange 49 57) (LenSpec.exactly 1)) false]])
      (Lrat.Derivation.NonZero.render d) (Lrat.Derivation.NonZero.capturesWith qual d) :=
