  by
  unfold Lrat.View.Valid Lrat.View.WfConstraints Lrat.WfConstraints
  infer_instance

theorem Lrat.computeValue_isSome (s : String) : Lrat.IsValid s → (Lrat.computeValue s).isSome :=
  by
  intro h
  have hengine := (Lrat.IsValid_equiv s).mp h
  unfold Triptych.isWf at hengine
  unfold Lrat.computeValue Triptych.scannerComputeValueMap
  rw [Option.isSome_map]
  exact hengine.1.1

def Lrat.parse (s : String) :=
  Triptych.decodedViewParse Lrat.directView Lrat.View.Valid Lrat.View.denotation id s

theorem Lrat.parse_eq_scanner (s : String) :
    Lrat.parse s = Triptych.scannerParseMap Lrat.grammar Lrat.constraints Lrat.valueFn id s := by
  calc
    Lrat.parse s = Triptych.gatedParseOfSpec Lrat.IsValid Lrat.computeValue id s :=
      by
      unfold Lrat.parse
      exact
        Triptych.decodedViewParse_eq_gatedParseOfSpec Lrat.directView Lrat.decodeView Lrat.View.Valid
          Lrat.View.denotation id Lrat.IsValid Lrat.computeValue Lrat.directView_eq_decodeView Lrat.IsValid_view
          Lrat.computeValue_view s
    _ = Triptych.gatedParse Lrat.IsValid Lrat.computeValue s := by simp [Triptych.gatedParseOfSpec]
    _ = Triptych.scannerParseMap Lrat.grammar Lrat.constraints Lrat.valueFn id s :=
      by
      symm
      unfold Lrat.computeValue
      exact
        Triptych.scannerParseMap_eq_surfaceGated Lrat.grammar Lrat.constraints Lrat.valueFn Lrat.IsValid
          Lrat.IsValid_equiv s

theorem Lrat.parse_eq_gated (s : String) : Lrat.parse s = Triptych.gatedParse Lrat.IsValid Lrat.computeValue s :=
  by
  rw [Lrat.parse_eq_scanner]
  unfold Lrat.computeValue
  exact
    Triptych.scannerParseMap_eq_surfaceGated Lrat.grammar Lrat.constraints Lrat.valueFn Lrat.IsValid Lrat.IsValid_equiv
      s

theorem Lrat.parse_profile_result (s : String) :
    (Triptych.scannerParseMapProfile Lrat.grammar Lrat.constraints Lrat.valueFn id s).result = Lrat.parse s :=
  by
  rw [Triptych.scannerParseMapProfile_result]
  exact (Lrat.parse_eq_scanner s).symm

theorem Lrat.parse_candidateChecks_le (s : String) :
    (Triptych.scannerParseMapProfile Lrat.grammar Lrat.constraints Lrat.valueFn id s).candidateChecks ≤
      Triptych.scannerCandidateBudget Lrat.grammar s :=
  Triptych.scannerParseMap_candidateChecks_le Lrat.grammar Lrat.constraints Lrat.valueFn id s

theorem Lrat.parse_candidateChecks_eq_zero_of_fastScan (s : String) (hunique : (Lrat.grammar).staticUnique = true)
    {captures : Triptych.CaptureMap} (hscan : Triptych.fastScan Lrat.grammar s = some captures) :
    (Triptych.scannerParseMapProfile Lrat.grammar Lrat.constraints Lrat.valueFn id s).candidateChecks = 0 :=
  Triptych.scannerParseMap_candidateChecks_eq_zero_of_fastScan Lrat.grammar Lrat.constraints Lrat.valueFn id s hunique
    hscan

theorem Lrat.parse_sound (s : String) (a : Array Std.Tactic.BVDecide.LRAT.IntAction) :
    Lrat.parse s = some a → Lrat.IsValid s ∧ Lrat.computeValue s = some a :=
  by
  rw [Lrat.parse_eq_gated]
  exact Triptych.gatedParse_sound _ _ s a

theorem Lrat.parse_complete (s : String) (a : Array Std.Tactic.BVDecide.LRAT.IntAction) :
    Lrat.IsValid s → Lrat.computeValue s = some a → Lrat.parse s = some a :=
  by
  rw [Lrat.parse_eq_gated]
  exact Triptych.gatedParse_complete _ _ s a

theorem Lrat.parse_reject (s : String) : Lrat.parse s = none ↔ ¬Lrat.IsValid s :=
  by
  rw [Lrat.parse_eq_gated]
  exact Triptych.gatedParse_reject _ _ Lrat.computeValue_isSome s

theorem Lrat.parse_view (s : String) :
    Lrat.parse s = if decide (Lrat.IsValid s) then (Lrat.decodeView s).map Lrat.View.denotation else none :=
  by
  rw [Lrat.parse_eq_gated]
  unfold Triptych.gatedParse
  rw [Lrat.computeValue_view]

theorem Lrat.parse_eq_some_iff_view (s : String) (a : Array Std.Tactic.BVDecide.LRAT.IntAction) :
    Lrat.parse s = some a ↔
      ∃ decodedView : Lrat.View,
        Lrat.decodeView s = some decodedView ∧ Lrat.View.Valid decodedView ∧ Lrat.View.denotation decodedView = a :=
  by
  constructor
  · intro hparse
    obtain ⟨hvalid, hvalue⟩ := Lrat.parse_sound s a hparse
    obtain ⟨decodedView, hview, hvalidView⟩ := (Lrat.IsValid_view s).mp hvalid
    refine ⟨decodedView, hview, hvalidView, ?_⟩
    rw [Lrat.computeValue_view, hview] at hvalue
    exact Option.some.inj hvalue
  · rintro ⟨decodedView, hview, hvalidView, hvalue⟩
    apply Lrat.parse_complete s a
    · exact (Lrat.IsValid_view s).mpr ⟨decodedView, hview, hvalidView⟩
    · rw [Lrat.computeValue_view, hview]
      exact congrArg some hvalue

theorem Lrat.parse_eq_none_iff_view (s : String) :
    Lrat.parse s = none ↔ ¬∃ v : Lrat.View, Lrat.decodeView s = some v ∧ Lrat.View.Valid v :=
  by
  rw [Lrat.parse_reject]
  constructor
  · intro hinvalid ⟨v, hview, hvalidView⟩
    exact hinvalid ((Lrat.IsValid_view s).mpr ⟨v, hview, hvalidView⟩)
  · intro hnoview hvalid
    exact hnoview ((Lrat.IsValid_view s).mp hvalid)
