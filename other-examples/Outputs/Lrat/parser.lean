theorem Lrat.IsWfGrammar_equiv (s : String) : Triptych.IsWf Lrat.grammar s ↔ Lrat.Production s :=
  by
  rw [isWf_eq_isWfProd_start, IsWfProd,
    show
      (Lrat.grammar).prod? (Lrat.grammar).start =
        some
          (Production.mk "Proof"
            [[SymItem.mk (Sym.rep "\n" (Sym.ref "Line") 1 (none : Option Nat)) false, SymItem.mk (Sym.lit "\n") false]])
      from rfl]
  have hstart :
    ∀ n,
      matchesProd Lrat.grammar n
          (Production.mk "Proof"
            [[SymItem.mk (Sym.rep "\n" (Sym.ref "Line") 1 (none : Option Nat)) false, SymItem.mk (Sym.lit "\n") false]])
          s =
        matchesSym Lrat.grammar (n + 1) (Sym.ref "Proof") s :=
    by
    intro n
    rw [matchesSym,
      show
        (Lrat.grammar).prod? "Proof" =
          some
            (Production.mk "Proof"
              [[SymItem.mk (Sym.rep "\n" (Sym.ref "Line") 1 (none : Option Nat)) false,
                  SymItem.mk (Sym.lit "\n") false]])
        from rfl]
  show
    matchesProd Lrat.grammar (Lrat.grammar).prods.length
        (Production.mk "Proof"
          [[SymItem.mk (Sym.rep "\n" (Sym.ref "Line") 1 (none : Option Nat)) false, SymItem.mk (Sym.lit "\n") false]])
        s ↔
      _
  rw [hstart]
  exact Lrat.Internal.matchesRef.Proof _ s

theorem Lrat.IsWf_equiv (s : String) : Lrat.IsWf s ↔ Triptych.isWf Lrat.grammar Lrat.constraints s :=
  by
  unfold Lrat.IsWf Triptych.isWf
  rw [Triptych.scan_eq_decode]
  rw [← Lrat.IsWfGrammar_equiv, ← decodeSome_iff_IsWf Lrat.grammar (by decide)]
  unfold Lrat.SatisfiesWfConstraints Lrat.WfConstraints Lrat.constraints
  simp only [Triptych.component, Triptych.componentList, Triptych.componentWith, Triptych.envOf, Triptych.captureMapOf,
    Triptych.scan_eq_decode, List.forall_mem_cons, List.forall_mem_singleton, List.not_mem_nil, forall_const,
    ConstraintEntry.wfPart, Constraint.eval, ValExpr.eval, presentCount, natOf_getD, intOf_getD, lenOf_getD,
    countOf_getD, signOf_getD, hexOf_getD, hexSeqOf_getD, segmentsOf_getD, Env.countVal, and_true, true_and,
    false_implies, implies_true, Bool.false_eq_true]
  try grind

theorem Lrat.IsValid_equiv (s : String) :
    Lrat.IsValid s ↔
      Triptych.isWf Lrat.grammar Lrat.constraints s ∧ Triptych.satisfiesConstraints Lrat.grammar Lrat.constraints s :=
  by
  unfold Lrat.IsValid
  rw [(Lrat.IsWf_equiv s)]
  unfold Triptych.satisfiesConstraints Triptych.captureMapOf Lrat.constraints
  simp only [List.forall_mem_cons, List.forall_mem_singleton, List.not_mem_nil, ConstraintEntry.valPart, false_implies,
    true_and, and_true]
  constructor
  · intro h
    exact ⟨h, fun _ => True.intro⟩
  · exact And.left

instance Lrat.instDecidableGrammar : DecidablePred Lrat.IsWf.Proof := fun s =>
  @decidable_of_iff _ _ (Lrat.IsWfGrammar_equiv s) (Triptych.decIsWfScanner Lrat.grammar (by decide) s)

instance Lrat.instDecidableIsWf : DecidablePred Lrat.IsWf := fun s =>
  @decidable_of_iff _ _ (Lrat.IsWf_equiv s).symm inferInstance

instance Lrat.instDecidableIsValid : DecidablePred Lrat.IsValid := fun s => inferInstance

theorem Lrat.View.wfConstraints_of_decode {s : String} {m : Triptych.CaptureMap} (h : decode Lrat.grammar s = some m) :
    Lrat.SatisfiesWfConstraints s ↔ Lrat.View.WfConstraints (Lrat.View.ofMap s m) :=
  by
  rw [Lrat.SatisfiesWfConstraints_of_decode h]
  rfl

theorem Lrat.IsValid_view (s : String) :
    Lrat.IsValid s ↔ ∃ v : Lrat.View, Lrat.decodeView s = some v ∧ Lrat.View.Valid v :=
  by
  constructor
  · intro hvalid
    have hengine := (Lrat.IsValid_equiv s).mp hvalid
    have hsome : (decode Lrat.grammar s).isSome = true := by simpa only [Triptych.scan_eq_decode] using hengine.1.1
    obtain ⟨m, hm⟩ := Option.isSome_iff_exists.mp hsome
    have hmDecode : decode Lrat.grammar s = some m := hm
    refine ⟨Lrat.View.ofMap s m, ?_, ?_⟩
    · unfold Lrat.decodeView
      simp [Triptych.scan_eq_decode, hmDecode]
    · exact (Lrat.View.wfConstraints_of_decode hmDecode).mp hvalid.2
  · rintro ⟨v, hview, hvalid⟩
    unfold Lrat.decodeView at hview
    rw [Option.map_eq_some_iff] at hview
    obtain ⟨m, hm, hv⟩ := hview
    subst v
    have hmDecode : decode Lrat.grammar s = some m := by simpa only [Triptych.scan_eq_decode] using hm
    have hdecoded : (decode Lrat.grammar s).isSome = true := by simp [hmDecode]
    have hgrammar := (Lrat.IsWfGrammar_equiv s).mp ((decodeSome_iff_IsWf Lrat.grammar (by decide) s).mp hdecoded)
    exact ⟨hgrammar, (Lrat.View.wfConstraints_of_decode hmDecode).mpr hvalid⟩

theorem Lrat.computeValue_eq (s : String) :
    Lrat.computeValue s =
      (decode Lrat.grammar s).map
        (fun _ =>
          Lrat.value
            (Triptych.componentWith Lrat.grammar s
              (fun m =>
                (Triptych.CaptureMap.groups "Line"
                      (fun key =>
                        ["Id", "Body", "Cr", "Pos", "Delete", "Add", "Zeros", "NonZero", "Digits", "DelIds", "Lits",
                                "RupHints", "RatSteps", "DelId", "Lit", "RupHint", "RatStep", "Neg", "RatPivot",
                                "RatTail", "RatHints", "RatHint"].contains
                            (Triptych.CaptureMap.keyProduction key) ||
                          key == "Line#count")
                      m).map
                  fun segment =>
                  ((Triptych.CaptureMap.toEnv segment "Id").getD "",
                    ((Triptych.CaptureMap.toEnv segment "Delete").getD "",
                      (Triptych.CaptureMap.toEnvList segment "DelId",
                        (Triptych.CaptureMap.toEnvList segment "Lit",
                          (Triptych.CaptureMap.toEnvList segment "RupHint",
                            (Triptych.CaptureMap.groups "RatStep"
                                  (fun key =>
                                    ["RatPivot", "RatTail", "Neg", "RatHints", "Pos", "RatHint", "Zeros", "NonZero",
                                            "Digits"].contains
                                        (Triptych.CaptureMap.keyProduction key) ||
                                      key == "RatStep#count")
                                  segment).map
                              fun segment =>
                              ((Triptych.CaptureMap.toEnv segment "RatPivot").getD "",
                                Triptych.CaptureMap.toEnvList segment "RatHint"))))))))) :=
  by
  unfold Lrat.computeValue Triptych.scannerComputeValueMap Triptych.componentWith Triptych.captureMapOf Lrat.valueFn
    Lrat.value
  rw [Triptych.scan_eq_decode]
  cases h : decode Lrat.grammar s with
  | none => simp [h]
  | some m =>
    simp [h, natOf_getD, intOf_getD, lenOf_getD, countOf_getD, signOf_getD, hexOf_getD, hexSeqOf_getD, segmentsOf_getD,
        Env.countVal, ValExpr.eval] <;>
