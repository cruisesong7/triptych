theorem Lrat.Derivation.Proof.decode_render_of_captureFunctional
    (hfunctional : Triptych.GrammarCaptureFunctional Lrat.grammar) (d : Lrat.Derivation.Proof)
    (hvalid : Lrat.Derivation.Proof.Valid d) :
    Triptych.decode Lrat.grammar (Lrat.Derivation.Proof.render d) = some (Lrat.Derivation.Proof.capturesWith "" d) :=
  Triptych.decode_eq_of_mem_fullParses hfunctional (mem_fullParses d hvalid)

theorem Lrat.decodeView_input {s : String} {v : Lrat.View} (h : Lrat.decodeView s = some v) : Lrat.View.input v = s :=
  by
  unfold Lrat.decodeView at h
  rw [Option.map_eq_some_iff] at h
  obtain ⟨m, _, hv⟩ := h
  subst v
  rfl

theorem Lrat.Derivation.Proof.decodeView_render_of_captureFunctional
    (hfunctional : Triptych.GrammarCaptureFunctional Lrat.grammar) (d : Lrat.Derivation.Proof)
    (hvalid : Lrat.Derivation.Proof.Valid d) :
    Lrat.decodeView (Lrat.Derivation.Proof.render d) = some (Lrat.Derivation.Proof.toView d) :=
  by
  unfold Lrat.decodeView Lrat.Derivation.Proof.toView
  rw [Triptych.scan_eq_decode]
  rw [Lrat.Derivation.Proof.decode_render_of_captureFunctional hfunctional d hvalid]
  rfl

theorem Lrat.SatisfiesWfConstraints_of_decode {s : String} {m : Triptych.CaptureMap}
    (h : decode Lrat.grammar s = some m) :
    Lrat.SatisfiesWfConstraints s ↔
      Lrat.WfConstraints
        ((Triptych.CaptureMap.groups "Line"
              (fun key =>
                ["Id", "Body", "Cr", "Pos", "Delete", "Add", "Zeros", "NonZero", "Digits", "DelIds", "Lits", "RupHints",
                        "RatSteps", "DelId", "Lit", "RupHint", "RatStep", "Neg", "RatPivot", "RatTail", "RatHints",
                        "RatHint"].contains
                    (Triptych.CaptureMap.keyProduction key) ||
                  key == "Line#count")
              m).map
          fun segment =>
          (Triptych.CaptureMap.toEnvList segment "Lit", Triptych.CaptureMap.toEnvList segment "RatPivot")) :=
  by
  unfold Lrat.SatisfiesWfConstraints
  simp only [Triptych.componentWith_eq_of_decode h
        (fun m =>
          (Triptych.CaptureMap.groups "Line"
                (fun key =>
                  ["Id", "Body", "Cr", "Pos", "Delete", "Add", "Zeros", "NonZero", "Digits", "DelIds", "Lits",
                          "RupHints", "RatSteps", "DelId", "Lit", "RupHint", "RatStep", "Neg", "RatPivot", "RatTail",
                          "RatHints", "RatHint"].contains
                      (Triptych.CaptureMap.keyProduction key) ||
                    key == "Line#count")
                m).map
            fun segment =>
            (Triptych.CaptureMap.toEnvList segment "Lit", Triptych.CaptureMap.toEnvList segment "RatPivot"))]

theorem Lrat.Internal.matchesRef.Zeros (fuel : Nat) (s : String) :
    matchesSym Lrat.grammar (fuel + 1) (Sym.ref "Zeros") s ↔ Lrat.IsWf.Zeros s :=
  by
  rw [matchesSym,
    show
      (Lrat.grammar).prod? "Zeros" =
