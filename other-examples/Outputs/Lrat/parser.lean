private theorem Lrat.decodeCaptures_eq_parsePlan (source : String) :
    Lrat.decodeCaptures source = ParsePlan.decode Lrat.parsePlan Lrat.grammar source := by
  calc
    Lrat.decodeCaptures source = SearchProgram.decode Lrat.searchProgram source := by
      exact Lrat.directDecode_eq_searchProgram source
    _ = SearchProgram.decode (lowerSearchPlan Lrat.searchPlan) source := by rw [Lrat.searchProgram_lowered]
    _ = ParsePlan.decode Lrat.parsePlan Lrat.grammar source := by rfl

private theorem Lrat.decodeCaptures_eq_scan (source : String) : Lrat.decodeCaptures source = scan Lrat.grammar source :=
  by
  calc
    Lrat.decodeCaptures source = ParsePlan.decode Lrat.parsePlan Lrat.grammar source :=
      Lrat.decodeCaptures_eq_parsePlan source
    _ = scan Lrat.grammar source :=
      ParsePlan.decode_eq_scan (ParsePlan.CertifiedFor.search Lrat.searchPlan_mirrorsGrammar) source

