theorem Lrat.computeValue_view (s : String) : Lrat.computeValue s = (Lrat.decodeView s).map Lrat.View.denotation :=
  by
  unfold Lrat.decodeView
  rw [Triptych.scan_eq_decode]
  cases h : decode Lrat.grammar s with
  |
    none =>
    rw [show Lrat.computeValue s = none by
        rw [Lrat.computeValue_eq, h]
        rfl]
    rfl
  | some m =>
    rw [Lrat.computeValue_of_decode h]
    simp only [Option.map_some]
    rfl

