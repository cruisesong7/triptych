theorem BitRows.IsWfGrammar_equiv (s : String) : Triptych.IsWf BitRows.grammar s ↔ BitRows.Production s :=
  by
  rw [isWf_eq_isWfProd_start, IsWfProd,
    show
      (BitRows.grammar).prod? (BitRows.grammar).start =
        some
          (Production.mk "Rows"
            [[SymItem.mk (Sym.ref "Width") false, SymItem.mk (Sym.lit ":") false, SymItem.mk (Sym.ref "First") false,
                SymItem.mk (Sym.lit "/") false, SymItem.mk (Sym.ref "Second") false]])
      from rfl]
  have hstart :
    ∀ n,
      matchesProd BitRows.grammar n
          (Production.mk "Rows"
            [[SymItem.mk (Sym.ref "Width") false, SymItem.mk (Sym.lit ":") false, SymItem.mk (Sym.ref "First") false,
                SymItem.mk (Sym.lit "/") false, SymItem.mk (Sym.ref "Second") false]])
          s =
        matchesSym BitRows.grammar (n + 1) (Sym.ref "Rows") s :=
    by
    intro n
    rw [matchesSym,
      show
        (BitRows.grammar).prod? "Rows" =
          some
            (Production.mk "Rows"
              [[SymItem.mk (Sym.ref "Width") false, SymItem.mk (Sym.lit ":") false, SymItem.mk (Sym.ref "First") false,
                  SymItem.mk (Sym.lit "/") false, SymItem.mk (Sym.ref "Second") false]])
        from rfl]
  show
    matchesProd BitRows.grammar (BitRows.grammar).prods.length
        (Production.mk "Rows"
          [[SymItem.mk (Sym.ref "Width") false, SymItem.mk (Sym.lit ":") false, SymItem.mk (Sym.ref "First") false,
              SymItem.mk (Sym.lit "/") false, SymItem.mk (Sym.ref "Second") false]])
        s ↔
      _
  rw [hstart]
  exact BitRows.Internal.matchesRef.Rows _ s

