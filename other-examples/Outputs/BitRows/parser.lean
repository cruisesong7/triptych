        BitRows.decodeView s = some decodedView ∧
          BitRows.View.Valid decodedView ∧ BitRows.View.denotation decodedView = b :=
  by
  constructor
  · intro hparse
    obtain ⟨hvalid, hvalue⟩ := BitRows.parse_sound s b hparse
    obtain ⟨decodedView, hview, hvalidView⟩ := (BitRows.IsValid_view s).mp hvalid
    refine ⟨decodedView, hview, hvalidView, ?_⟩
    rw [BitRows.computeValue_view, hview] at hvalue
    exact Option.some.inj hvalue
  · rintro ⟨decodedView, hview, hvalidView, hvalue⟩
    apply BitRows.parse_complete s b
    · exact (BitRows.IsValid_view s).mpr ⟨decodedView, hview, hvalidView⟩
    · rw [BitRows.computeValue_view, hview]
      exact congrArg some hvalue

theorem BitRows.parse_eq_none_iff_view (s : String) :
    BitRows.parse s = none ↔ ¬∃ v : BitRows.View, BitRows.decodeView s = some v ∧ BitRows.View.Valid v :=
  by
  rw [BitRows.parse_reject]
  constructor
  · intro hinvalid ⟨v, hview, hvalidView⟩
    exact hinvalid ((BitRows.IsValid_view s).mpr ⟨v, hview, hvalidView⟩)
  · intro hnoview hvalid
    exact hnoview ((BitRows.IsValid_view s).mp hvalid)
