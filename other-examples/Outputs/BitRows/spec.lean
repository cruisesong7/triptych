`value`. Empty phases are omitted; `IsWf` and `IsValid` specialize accordingly.
This file is proof-free — it is what you cite. -/

def BitRows.grammar : Grammar :=
  Grammar.mk "Rows"
    [Production.mk "Rows"
        [[SymItem.mk (Sym.ref "Width") false, SymItem.mk (Sym.lit ":") false, SymItem.mk (Sym.ref "First") false,
            SymItem.mk (Sym.lit "/") false, SymItem.mk (Sym.ref "Second") false]],
      Production.mk "Width" [[SymItem.mk (Sym.term TokClass.digit (LenSpec.between 1 2)) false]],
      Production.mk "First"
        [[SymItem.mk (Sym.lit "") false], [SymItem.mk (Sym.term TokClass.bit LenSpec.atLeastOne) false]],
      Production.mk "Second"
        [[SymItem.mk (Sym.lit "") false], [SymItem.mk (Sym.term TokClass.hexDigit LenSpec.atLeastOne) false]]]

inductive BitRows.Derivation.Width where
  | alt0 (part0 : String)
  deriving Repr, DecidableEq

def BitRows.Derivation.Width.render : BitRows.Derivation.Width → String
  | .alt0 part0 => (part0 ++ "")

def BitRows.Derivation.Width.Valid : BitRows.Derivation.Width → Prop
  | .alt0 part0 => matchesTerm TokClass.digit (LenSpec.between 1 2) part0

inductive BitRows.Derivation.First where
  | alt0
  | alt1 (part0 : String)
  deriving Repr, DecidableEq

def BitRows.Derivation.First.render : BitRows.Derivation.First → String
  | .alt0 => ("" ++ "")
  | .alt1 part0 => (part0 ++ "")

def BitRows.Derivation.First.Valid : BitRows.Derivation.First → Prop
  | .alt0 => True
  | .alt1 part0 => matchesTerm TokClass.bit (LenSpec.atLeastOne) part0

inductive BitRows.Derivation.Second where
  | alt0
  | alt1 (part0 : String)
  deriving Repr, DecidableEq

def BitRows.Derivation.Second.render : BitRows.Derivation.Second → String
  | .alt0 => ("" ++ "")
  | .alt1 part0 => (part0 ++ "")

def BitRows.Derivation.Second.Valid : BitRows.Derivation.Second → Prop
  | .alt0 => True
  | .alt1 part0 => matchesTerm TokClass.hexDigit (LenSpec.atLeastOne) part0

inductive BitRows.Derivation.Rows where
  | alt0 (part0 : BitRows.Derivation.Width) (part2 : BitRows.Derivation.First) (part4 : BitRows.Derivation.Second)
  deriving Repr, DecidableEq

def BitRows.Derivation.Rows.render : BitRows.Derivation.Rows → String
  | .alt0 part0 part2 part4 =>
    (BitRows.Derivation.Width.render part0 ++
      (":" ++ (BitRows.Derivation.First.render part2 ++ ("/" ++ (BitRows.Derivation.Second.render part4 ++ "")))))

def BitRows.Derivation.Rows.Valid : BitRows.Derivation.Rows → Prop
  | .alt0 part0 part2 part4 =>
    (BitRows.Derivation.Width.Valid part0 ∧
      (BitRows.Derivation.First.Valid part2 ∧ BitRows.Derivation.Second.Valid part4))

def BitRows.IsWf.Width (s : String) : Prop :=
  IsDigitsBetween 1 2 s

def BitRows.IsWf.First (s : String) : Prop :=
  s = "" ∨ IsBits s

def BitRows.IsWf.Second (s : String) : Prop :=
  s = "" ∨ IsHexDigits s

def BitRows.Production (s : String) : Prop :=
  ∃ width first second,
    ((s = width ++ ":" ++ first ++ "/" ++ second ∧ BitRows.IsWf.Width width) ∧ BitRows.IsWf.First first) ∧
      BitRows.IsWf.Second second

abbrev BitRows.IsWf.Rows (s : String) : Prop :=
  BitRows.Production s

def BitRows.value (width : String) (first : String) (second : String) :=
  toBitRows width first second

def BitRows.WfConstraints (first : String) (width : String) (second : String) : Prop :=
  (first).length = rowWidth width ∧ (second).length = rowWidth width

def BitRows.SatisfiesWfConstraints (s : String) : Prop :=
  BitRows.WfConstraints (Triptych.component BitRows.grammar s "First") (Triptych.component BitRows.grammar s "Width")
    (Triptych.component BitRows.grammar s "Second")

abbrev BitRows.IsWf (s : String) : Prop :=
  BitRows.Production s ∧ BitRows.SatisfiesWfConstraints s

abbrev BitRows.IsValid (s : String) : Prop :=
  BitRows.IsWf s

def BitRows.Denotes (s : String) (b : BitRowsExample.BitRows) : Prop :=
  BitRows.IsValid s ∧
    b =
      BitRows.value (Triptych.component BitRows.grammar s "Width") (Triptych.component BitRows.grammar s "First")
        (Triptych.component BitRows.grammar s "Second")

structure BitRows.View where
  input : String
  width : String
  first : String
  second : String

def BitRows.View.WfConstraints (v : BitRows.View) : Prop :=
  BitRows.WfConstraints (BitRows.View.first v) (BitRows.View.width v) (BitRows.View.second v)

abbrev BitRows.View.Valid (v : BitRows.View) : Prop :=
