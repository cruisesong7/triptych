theorem Graph.IsWfGrammar_equiv (s : String) : Triptych.IsWf Graph.grammar s ↔ Graph.Production s :=
  by
  rw [isWf_eq_isWfProd_start, IsWfProd,
    show
      (Graph.grammar).prod? (Graph.grammar).start =
        some
          (Production.mk "Graph"
            [[SymItem.mk (Sym.ref "Order") false, SymItem.mk (Sym.lit ":") false, SymItem.mk (Sym.ref "Cells") false]])
      from rfl]
  have hstart :
    ∀ n,
      matchesProd Graph.grammar n
          (Production.mk "Graph"
            [[SymItem.mk (Sym.ref "Order") false, SymItem.mk (Sym.lit ":") false, SymItem.mk (Sym.ref "Cells") false]])
          s =
        matchesSym Graph.grammar (n + 1) (Sym.ref "Graph") s :=
    by
    intro n
    rw [matchesSym,
      show
        (Graph.grammar).prod? "Graph" =
          some
            (Production.mk "Graph"
              [[SymItem.mk (Sym.ref "Order") false, SymItem.mk (Sym.lit ":") false,
                  SymItem.mk (Sym.ref "Cells") false]])
        from rfl]
  show
    matchesProd Graph.grammar (Graph.grammar).prods.length
        (Production.mk "Graph"
          [[SymItem.mk (Sym.ref "Order") false, SymItem.mk (Sym.lit ":") false, SymItem.mk (Sym.ref "Cells") false]])
        s ↔
      _
  rw [hstart]
  exact Graph.Internal.matchesRef.Graph _ s

