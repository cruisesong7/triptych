/- ═══════════════════════════════ spec ═══════════════════════════════
The more readable specification. Each production of the input grammar becomes an
inlined well-formedness predicate `IsWf.*` written as a plain existential over the
named captures, so you can read it side-by-side with the grammar and check that it
says the same thing. The start rule is named `Production`; `IsWf.<Start>` and
top-level `IsWf` reuse it. When a value is present, `Denotes` combines valid syntax
with the readable value function. `WfConstraints` contains capture-derived format
conditions and `Constraints` contains conditions that explicitly mention the final
`value`. Empty phases are omitted; `IsWf` and `IsValid` specialize accordingly.
This file is proof-free — it is what you cite. -/

def Dimacs.grammar : Grammar :=
  Grammar.mk "File"
    [Production.mk "File"
        [[SymItem.mk (Sym.ref "Comments") true, SymItem.mk (Sym.ref "Header") false,
            SymItem.mk (Sym.ref "Clauses") true, SymItem.mk (Sym.ref "Ws") true]],
      Production.mk "Comments" [[SymItem.mk (Sym.rep "" (Sym.ref "Comment") (1 : Nat) (none : Option Nat)) false]],
      Production.mk "Comment"
        [[SymItem.mk (Sym.lit "c") false, SymItem.mk (Sym.ref "Text") true, SymItem.mk (Sym.lit "\n") false]],
      Production.mk "Text"
        [[SymItem.mk (Sym.term (TokClass.noneOf (List.cons '\n' List.nil)) LenSpec.atLeastOne) false]],
      Production.mk "Header"
        [[SymItem.mk (Sym.lit "p") false, SymItem.mk (Sym.ref "Blank") false, SymItem.mk (Sym.lit "cnf") false,
            SymItem.mk (Sym.ref "Blank") false, SymItem.mk (Sym.ref "Vars") false, SymItem.mk (Sym.ref "Blank") false,
            SymItem.mk (Sym.ref "Count") false]],
      Production.mk "Vars" [[SymItem.mk (Sym.term TokClass.digit LenSpec.atLeastOne) false]],
      Production.mk "Count" [[SymItem.mk (Sym.term TokClass.digit LenSpec.atLeastOne) false]],
      Production.mk "Clauses" [[SymItem.mk (Sym.rep "" (Sym.ref "Clause") (1 : Nat) (none : Option Nat)) false]],
      Production.mk "Clause"
        [[SymItem.mk (Sym.ref "Lits") true, SymItem.mk (Sym.ref "Ws") false, SymItem.mk (Sym.lit "0") false]],
      Production.mk "Lits" [[SymItem.mk (Sym.rep "" (Sym.ref "WsLit") (1 : Nat) (none : Option Nat)) false]],
      Production.mk "WsLit" [[SymItem.mk (Sym.ref "Ws") false, SymItem.mk (Sym.ref "Lit") false]],
      Production.mk "Lit" [[SymItem.mk (Sym.ref "Sign") false, SymItem.mk (Sym.ref "Var") false]],
      Production.mk "Sign" [[SymItem.mk (Sym.lit "-") true]],
      Production.mk "Var" [[SymItem.mk (Sym.ref "NonZero") false, SymItem.mk (Sym.ref "Digits") true]],
      Production.mk "NonZero"
        [[SymItem.mk (Sym.term ((TokClass.asciiRange 49 57 : TokClass)) (LenSpec.exactly 1)) false]],
      Production.mk "Digits" [[SymItem.mk (Sym.term TokClass.digit LenSpec.atLeastOne) false]],
      Production.mk "Blank"
        [[SymItem.mk (Sym.term (TokClass.oneOf (List.cons ' ' (List.cons '\t' List.nil))) LenSpec.atLeastOne) false]],
      Production.mk "Ws"
        [[SymItem.mk
              (Sym.term (TokClass.oneOf (List.cons ' ' (List.cons '\t' (List.cons '\x0d' (List.cons '\n' List.nil)))))
                LenSpec.atLeastOne)
              false]]]

