def Dimacs.IsWf.Text (s : String) : Prop :=
  matchesTerm (TokClass.noneOf (List.cons '\n' List.nil)) LenSpec.atLeastOne s

def Dimacs.IsWf.Comment (s : String) : Prop :=
  ∃ rest, s = "c" ++ rest ∧ ((∃ text rest₁, rest = text ++ rest₁ ∧ Dimacs.IsWf.Text text ∧ rest₁ = "\n") ∨ rest = "\n")

def Dimacs.IsWf.Comments (s : String) : Prop :=
  ∃ parts : List String,
    1 ≤ parts.length ∧ True ∧ (∀ p ∈ parts, Dimacs.IsWf.Comment p) ∧ s = String.intercalate "" parts

def Dimacs.IsWf.Blank (s : String) : Prop :=
  matchesTerm (TokClass.oneOf (List.cons ' ' (List.cons '\t' List.nil))) LenSpec.atLeastOne s

def Dimacs.IsWf.Vars (s : String) : Prop :=
  IsDigits s

def Dimacs.IsWf.Count (s : String) : Prop :=
  IsDigits s

def Dimacs.IsWf.Header (s : String) : Prop :=
  ∃ blank0 blank1 vars blank2 «count»,
    ((((s = "p" ++ blank0 ++ "cnf" ++ blank1 ++ vars ++ blank2 ++ «count» ∧ Dimacs.IsWf.Blank blank0) ∧
            Dimacs.IsWf.Blank blank1) ∧
          Dimacs.IsWf.Vars vars) ∧
        Dimacs.IsWf.Blank blank2) ∧
      Dimacs.IsWf.Count «count»

def Dimacs.IsWf.Ws (s : String) : Prop :=
  matchesTerm (TokClass.oneOf (List.cons ' ' (List.cons '\t' (List.cons '\x0d' (List.cons '\n' List.nil)))))
    LenSpec.atLeastOne s

def Dimacs.IsWf.Sign (s : String) : Prop :=
  s = "-" ∨ s = ""

def Dimacs.IsWf.NonZero (s : String) : Prop :=
  matchesTerm ((TokClass.asciiRange 49 57 : TokClass)) (LenSpec.exactly 1) s

def Dimacs.IsWf.Digits (s : String) : Prop :=
  IsDigits s

def Dimacs.IsWf.Var (s : String) : Prop :=
  ∃ nonZero rest, s = nonZero ++ rest ∧ Dimacs.IsWf.NonZero nonZero ∧ (Dimacs.IsWf.Digits rest ∨ rest = "")

def Dimacs.IsWf.Lit (s : String) : Prop :=
  ∃ «sign» var, (s = «sign» ++ var ∧ Dimacs.IsWf.Sign «sign») ∧ Dimacs.IsWf.Var var

def Dimacs.IsWf.WsLit (s : String) : Prop :=
  ∃ ws lit, (s = ws ++ lit ∧ Dimacs.IsWf.Ws ws) ∧ Dimacs.IsWf.Lit lit

def Dimacs.IsWf.Lits (s : String) : Prop :=
  ∃ parts : List String, 1 ≤ parts.length ∧ True ∧ (∀ p ∈ parts, Dimacs.IsWf.WsLit p) ∧ s = String.intercalate "" parts

def Dimacs.IsWf.Clause (s : String) : Prop :=
  (∃ lits rest,
      s = lits ++ rest ∧ Dimacs.IsWf.Lits lits ∧ ∃ ws rest₁, rest = ws ++ rest₁ ∧ Dimacs.IsWf.Ws ws ∧ rest₁ = "0") ∨
    ∃ ws rest₁, s = ws ++ rest₁ ∧ Dimacs.IsWf.Ws ws ∧ rest₁ = "0"

def Dimacs.IsWf.Clauses (s : String) : Prop :=
  ∃ parts : List String, 1 ≤ parts.length ∧ True ∧ (∀ p ∈ parts, Dimacs.IsWf.Clause p) ∧ s = String.intercalate "" parts

def Dimacs.Production (s : String) : Prop :=
  (∃ comments rest,
      s = comments ++ rest ∧
        Dimacs.IsWf.Comments comments ∧
          ∃ header rest₁,
            rest = header ++ rest₁ ∧
              Dimacs.IsWf.Header header ∧
                ((∃ clauses rest₂,
                    rest₁ = clauses ++ rest₂ ∧ Dimacs.IsWf.Clauses clauses ∧ (Dimacs.IsWf.Ws rest₂ ∨ rest₂ = "")) ∨
                  Dimacs.IsWf.Ws rest₁ ∨ rest₁ = "")) ∨
    ∃ header rest₁,
      s = header ++ rest₁ ∧
        Dimacs.IsWf.Header header ∧
          ((∃ clauses rest₂,
              rest₁ = clauses ++ rest₂ ∧ Dimacs.IsWf.Clauses clauses ∧ (Dimacs.IsWf.Ws rest₂ ∨ rest₂ = "")) ∨
            Dimacs.IsWf.Ws rest₁ ∨ rest₁ = "")

abbrev Dimacs.IsWf.File (s : String) : Prop :=
  Dimacs.Production s

def Dimacs.value (clauseGroups : List (List (String × String))) : List (List Int) :=
  (clauseGroups).map fun litGroups => (litGroups).map fun («sign», var) => signOf «sign» * natOf var

def Dimacs.forall0 (litGroups : List String) (vars : String) : Bool :=
  (litGroups).all fun var => decide (natOf var ≤ natOf vars)

def Dimacs.WfConstraints (clause_count : String) («count» : String) (lit : List String) (vars : String) : Prop :=
  countOf clause_count = natOf «count» ∧ Dimacs.forall0 lit vars = true

def Dimacs.SatisfiesWfConstraints (s : String) : Prop :=
  Dimacs.WfConstraints (Triptych.component Dimacs.grammar s "Clause#count")
    (Triptych.component Dimacs.grammar s "Count")
    (Triptych.componentWith Dimacs.grammar s
      (fun m =>
        (Triptych.CaptureMap.groups "Lit"
              (fun key =>
                ["Sign", "Var", "NonZero", "Digits"].contains (Triptych.CaptureMap.keyProduction key) ||
                  key == "Lit#count")
              m).map
          fun segment => (Triptych.CaptureMap.toEnv segment "Var").getD ""))
    (Triptych.component Dimacs.grammar s "Vars")

abbrev Dimacs.IsWf (s : String) : Prop :=
  Dimacs.Production s ∧ Dimacs.SatisfiesWfConstraints s

abbrev Dimacs.IsValid (s : String) : Prop :=
  Dimacs.IsWf s

def Dimacs.Denotes (s : String) (l : List (List Int)) : Prop :=
  Dimacs.IsValid s ∧
    l =
      Dimacs.value
        (Triptych.componentWith Dimacs.grammar s
          (fun m =>
            (Triptych.CaptureMap.groups "Clause"
                  (fun key =>
                    ["Lits", "Ws", "WsLit", "Lit", "Sign", "Var", "NonZero", "Digits"].contains
                        (Triptych.CaptureMap.keyProduction key) ||
                      key == "Clause#count")
                  m).map
              fun segment =>
              (Triptych.CaptureMap.groups "Lit"
                    (fun key =>
                      ["Sign", "Var", "NonZero", "Digits"].contains (Triptych.CaptureMap.keyProduction key) ||
                        key == "Lit#count")
                    segment).map
                fun segment =>
                ((Triptych.CaptureMap.toEnv segment "Sign").getD "",
                  (Triptych.CaptureMap.toEnv segment "Var").getD "")))

structure Dimacs.View where
  input : String
  clauseGroups : List (List (String × String))
  clause_count : Option String
  «count» : String
  litGroups : List (String)
  vars : String

def Dimacs.View.WfConstraints (v : Dimacs.View) : Prop :=
  Dimacs.WfConstraints ((Dimacs.View.clause_count v).getD "") (Dimacs.View.count v) (Dimacs.View.litGroups v)
    (Dimacs.View.vars v)

abbrev Dimacs.View.Valid (v : Dimacs.View) : Prop :=
  Dimacs.View.WfConstraints v

def Dimacs.View.denotation (v : Dimacs.View) :=
  Dimacs.value (Dimacs.View.clauseGroups v)
