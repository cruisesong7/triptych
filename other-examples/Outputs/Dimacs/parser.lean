      Dimacs.decodeCaptures_eq_parsePlan source
    _ = scan Dimacs.grammar source :=
      ParsePlan.decode_eq_scan (ParsePlan.CertifiedFor.search Dimacs.searchPlan_mirrorsGrammar) source

private def Dimacs.directView (source : String) : Option Dimacs.View :=
  (Dimacs.directDecode source).map (Dimacs.View.ofMap source)

private theorem Dimacs.directView_eq_decodeView (source : String) :
    Dimacs.directView source = Dimacs.decodeView source :=
  by
  unfold Dimacs.directView Dimacs.decodeView
  rw [show Dimacs.directDecode source = scan Dimacs.grammar source by exact Dimacs.decodeCaptures_eq_scan source]

private instance Dimacs.instDecidableViewValid : DecidablePred Dimacs.View.Valid := fun view =>
  by
  unfold Dimacs.View.Valid Dimacs.View.WfConstraints Dimacs.WfConstraints
  infer_instance

theorem Dimacs.computeValue_isSome (s : String) : Dimacs.IsValid s → (Dimacs.computeValue s).isSome :=
  by
  intro h
  have hengine := (Dimacs.IsValid_equiv s).mp h
  unfold Triptych.isWf at hengine
  unfold Dimacs.computeValue Triptych.scannerComputeValueMap
  rw [Option.isSome_map]
  exact hengine.1.1

def Dimacs.parse (s : String) :=
  Triptych.decodedViewParse Dimacs.directView Dimacs.View.Valid Dimacs.View.denotation id s

theorem Dimacs.parse_eq_scanner (s : String) :
    Dimacs.parse s = Triptych.scannerParseMap Dimacs.grammar Dimacs.constraints Dimacs.valueFn id s := by
  calc
    Dimacs.parse s = Triptych.gatedParseOfSpec Dimacs.IsValid Dimacs.computeValue id s :=
      by
      unfold Dimacs.parse
      exact
        Triptych.decodedViewParse_eq_gatedParseOfSpec Dimacs.directView Dimacs.decodeView Dimacs.View.Valid
          Dimacs.View.denotation id Dimacs.IsValid Dimacs.computeValue Dimacs.directView_eq_decodeView
          Dimacs.IsValid_view Dimacs.computeValue_view s
    _ = Triptych.gatedParse Dimacs.IsValid Dimacs.computeValue s := by simp [Triptych.gatedParseOfSpec]
    _ = Triptych.scannerParseMap Dimacs.grammar Dimacs.constraints Dimacs.valueFn id s :=
      by
      symm
      unfold Dimacs.computeValue
      exact
        Triptych.scannerParseMap_eq_surfaceGated Dimacs.grammar Dimacs.constraints Dimacs.valueFn Dimacs.IsValid
          Dimacs.IsValid_equiv s

theorem Dimacs.parse_eq_gated (s : String) :
    Dimacs.parse s = Triptych.gatedParse Dimacs.IsValid Dimacs.computeValue s :=
  by
  rw [Dimacs.parse_eq_scanner]
  unfold Dimacs.computeValue
  exact
    Triptych.scannerParseMap_eq_surfaceGated Dimacs.grammar Dimacs.constraints Dimacs.valueFn Dimacs.IsValid
      Dimacs.IsValid_equiv s

theorem Dimacs.parse_profile_result (s : String) :
    (Triptych.scannerParseMapProfile Dimacs.grammar Dimacs.constraints Dimacs.valueFn id s).result = Dimacs.parse s :=
  by
  rw [Triptych.scannerParseMapProfile_result]
  exact (Dimacs.parse_eq_scanner s).symm

theorem Dimacs.parse_candidateChecks_le (s : String) :
    (Triptych.scannerParseMapProfile Dimacs.grammar Dimacs.constraints Dimacs.valueFn id s).candidateChecks ≤
      Triptych.scannerCandidateBudget Dimacs.grammar s :=
  Triptych.scannerParseMap_candidateChecks_le Dimacs.grammar Dimacs.constraints Dimacs.valueFn id s

theorem Dimacs.parse_candidateChecks_eq_zero_of_fastScan (s : String) (hunique : (Dimacs.grammar).staticUnique = true)
    {captures : Triptych.CaptureMap} (hscan : Triptych.fastScan Dimacs.grammar s = some captures) :
    (Triptych.scannerParseMapProfile Dimacs.grammar Dimacs.constraints Dimacs.valueFn id s).candidateChecks = 0 :=
  Triptych.scannerParseMap_candidateChecks_eq_zero_of_fastScan Dimacs.grammar Dimacs.constraints Dimacs.valueFn id s
    hunique hscan

theorem Dimacs.parse_sound (s : String) (l : List (List Int)) :
    Dimacs.parse s = some l → Dimacs.IsValid s ∧ Dimacs.computeValue s = some l :=
  by
  rw [Dimacs.parse_eq_gated]
  exact Triptych.gatedParse_sound _ _ s l

theorem Dimacs.parse_complete (s : String) (l : List (List Int)) :
    Dimacs.IsValid s → Dimacs.computeValue s = some l → Dimacs.parse s = some l :=
  by
  rw [Dimacs.parse_eq_gated]
  exact Triptych.gatedParse_complete _ _ s l

theorem Dimacs.parse_reject (s : String) : Dimacs.parse s = none ↔ ¬Dimacs.IsValid s :=
  by
  rw [Dimacs.parse_eq_gated]
  exact Triptych.gatedParse_reject _ _ Dimacs.computeValue_isSome s

theorem Dimacs.parse_view (s : String) :
    Dimacs.parse s = if decide (Dimacs.IsValid s) then (Dimacs.decodeView s).map Dimacs.View.denotation else none :=
  by
  rw [Dimacs.parse_eq_gated]
  unfold Triptych.gatedParse
  rw [Dimacs.computeValue_view]

theorem Dimacs.parse_eq_some_iff_view (s : String) (l : List (List Int)) :
    Dimacs.parse s = some l ↔
      ∃ decodedView : Dimacs.View,
        Dimacs.decodeView s = some decodedView ∧
          Dimacs.View.Valid decodedView ∧ Dimacs.View.denotation decodedView = l :=
  by
  constructor
  · intro hparse
    obtain ⟨hvalid, hvalue⟩ := Dimacs.parse_sound s l hparse
    obtain ⟨decodedView, hview, hvalidView⟩ := (Dimacs.IsValid_view s).mp hvalid
    refine ⟨decodedView, hview, hvalidView, ?_⟩
    rw [Dimacs.computeValue_view, hview] at hvalue
    exact Option.some.inj hvalue
  · rintro ⟨decodedView, hview, hvalidView, hvalue⟩
    apply Dimacs.parse_complete s l
    · exact (Dimacs.IsValid_view s).mpr ⟨decodedView, hview, hvalidView⟩
    · rw [Dimacs.computeValue_view, hview]
      exact congrArg some hvalue

theorem Dimacs.parse_eq_none_iff_view (s : String) :
    Dimacs.parse s = none ↔ ¬∃ v : Dimacs.View, Dimacs.decodeView s = some v ∧ Dimacs.View.Valid v :=
  by
  rw [Dimacs.parse_reject]
  constructor
  · intro hinvalid ⟨v, hview, hvalidView⟩
    exact hinvalid ((Dimacs.IsValid_view s).mpr ⟨v, hview, hvalidView⟩)
  · intro hnoview hvalid
    exact hnoview ((Dimacs.IsValid_view s).mp hvalid)
