theorem Dimacs.IsWfGrammar_equiv (s : String) : Triptych.IsWf Dimacs.grammar s ↔ Dimacs.Production s :=
  by
  rw [isWf_eq_isWfProd_start, IsWfProd,
    show
      (Dimacs.grammar).prod? (Dimacs.grammar).start =
        some
          (Production.mk "File"
            [[SymItem.mk (Sym.ref "Comments") true, SymItem.mk (Sym.ref "Header") false,
                SymItem.mk (Sym.ref "Clauses") true, SymItem.mk (Sym.ref "Ws") true]])
      from rfl]
  have hstart :
    ∀ n,
      matchesProd Dimacs.grammar n
          (Production.mk "File"
            [[SymItem.mk (Sym.ref "Comments") true, SymItem.mk (Sym.ref "Header") false,
                SymItem.mk (Sym.ref "Clauses") true, SymItem.mk (Sym.ref "Ws") true]])
          s =
        matchesSym Dimacs.grammar (n + 1) (Sym.ref "File") s :=
    by
    intro n
    rw [matchesSym,
      show
        (Dimacs.grammar).prod? "File" =
          some
            (Production.mk "File"
              [[SymItem.mk (Sym.ref "Comments") true, SymItem.mk (Sym.ref "Header") false,
                  SymItem.mk (Sym.ref "Clauses") true, SymItem.mk (Sym.ref "Ws") true]])
        from rfl]
  show
    matchesProd Dimacs.grammar (Dimacs.grammar).prods.length
        (Production.mk "File"
          [[SymItem.mk (Sym.ref "Comments") true, SymItem.mk (Sym.ref "Header") false,
              SymItem.mk (Sym.ref "Clauses") true, SymItem.mk (Sym.ref "Ws") true]])
        s ↔
      _
  rw [hstart]
  exact Dimacs.Internal.matchesRef.File _ s

