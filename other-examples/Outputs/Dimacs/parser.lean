        [[SymItem.mk (Sym.ref "Comments") true, SymItem.mk (Sym.ref "Header") false,
            SymItem.mk (Sym.ref "Clauses") true, SymItem.mk (Sym.ref "Ws") true]])
      (Dimacs.Derivation.File.render d) (Dimacs.Derivation.File.capturesWith qual d) :=
  by
  cases d with
  | alt0 part0 part1 part2 part3 =>
    simp only [Dimacs.Derivation.File.Valid] at hvalid
    rcases hvalid with ⟨hpart0, hpart1, hpart2, hpart3⟩
    simp only [Dimacs.Derivation.File.render, Dimacs.Derivation.File.capturesWith]
    apply
      Triptych.prodMatch_of_alt (alt :=
        [SymItem.mk (Sym.ref "Comments") true, SymItem.mk (Sym.ref "Header") false, SymItem.mk (Sym.ref "Clauses") true,
          SymItem.mk (Sym.ref "Ws") true])
    · simp
    ·
      exact
        (by
          apply Triptych.seqMatch_optional (valid := fun entry => Dimacs.Derivation.Comments.Valid entry)
          · exact hpart0
          · intro entry hentry
            exact
              (by
                simpa only [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
                  (Triptych.symMatch_ref Dimacs.grammar qual (((fuel + 4)) + 3) "Comments"
                    (Production.mk "Comments"
                      [[SymItem.mk (Sym.rep "" (Sym.ref "Comment") 1 ((none : Option Nat))) false]])
                    (by rfl) (Dimacs.Derivation.Comments.render entry)
                    (Dimacs.Derivation.Comments.capturesWith "Comments" entry)
                    (Dimacs.Derivation.Comments.matches "Comments" (fuel + 4) entry hentry)))
          ·
            exact
              (by
                apply Triptych.seqMatch_required
                ·
                  exact
                    (by
                      simpa only [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
                        (Triptych.symMatch_ref Dimacs.grammar qual (((fuel + 5)) + 2) "Header"
                          (Production.mk "Header"
                            [[SymItem.mk (Sym.lit "p") false, SymItem.mk (Sym.ref "Blank") false,
                                SymItem.mk (Sym.lit "cnf") false, SymItem.mk (Sym.ref "Blank") false,
                                SymItem.mk (Sym.ref "Vars") false, SymItem.mk (Sym.ref "Blank") false,
                                SymItem.mk (Sym.ref "Count") false]])
                          (by rfl) (Dimacs.Derivation.Header.render part1)
                          (Dimacs.Derivation.Header.capturesWith "Header" part1)
                          (Dimacs.Derivation.Header.matches "Header" (fuel + 5) part1 hpart1)))
                ·
                  exact
                    (by
                      apply Triptych.seqMatch_optional (valid := fun entry => Dimacs.Derivation.Clauses.Valid entry)
                      · exact hpart2
                      · intro entry hentry
                        exact
                          (by
                            simpa only [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
                              (Triptych.symMatch_ref Dimacs.grammar qual (((fuel + 0)) + 7) "Clauses"
                                (Production.mk "Clauses"
                                  [[SymItem.mk (Sym.rep "" (Sym.ref "Clause") 1 ((none : Option Nat))) false]])
                                (by rfl) (Dimacs.Derivation.Clauses.render entry)
                                (Dimacs.Derivation.Clauses.capturesWith "Clauses" entry)
                                (Dimacs.Derivation.Clauses.matches "Clauses" (fuel + 0) entry hentry)))
                      ·
                        exact
                          (by
                            apply Triptych.seqMatch_optional (valid := fun entry => Dimacs.Derivation.Ws.Valid entry)
                            · exact hpart3
                            · intro entry hentry
                              exact
                                (by
                                  simpa only [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
                                    (Triptych.symMatch_ref Dimacs.grammar qual (((fuel + 6)) + 1) "Ws"
                                      (Production.mk "Ws"
                                        [[SymItem.mk
                                              (Sym.term (TokClass.oneOf [' ', '\t', '\x0d', '\n']) (LenSpec.atLeastOne))
                                              false]])
                                      (by rfl) (Dimacs.Derivation.Ws.render entry)
                                      (Dimacs.Derivation.Ws.capturesWith "Ws" entry)
                                      (Dimacs.Derivation.Ws.matches "Ws" (fuel + 6) entry hentry)))
                            · exact Triptych.seqMatch_nil Dimacs.grammar qual (fuel + 8)))))

theorem Dimacs.Derivation.File.mem_fullParses (d : Dimacs.Derivation.File) (hvalid : Dimacs.Derivation.File.Valid d) :
    Dimacs.Derivation.File.capturesWith "" d ∈ Triptych.fullParses Dimacs.grammar (Dimacs.Derivation.File.render d) :=
  by
  apply
    Triptych.prodMatch_mem_fullParses Dimacs.grammar
      (Production.mk "File"
        [[SymItem.mk (Sym.ref "Comments") true, SymItem.mk (Sym.ref "Header") false,
            SymItem.mk (Sym.ref "Clauses") true, SymItem.mk (Sym.ref "Ws") true]])
      (by rfl)
  simpa [Dimacs.grammar] using (Dimacs.Derivation.File.matches "" 10 d hvalid)

theorem Dimacs.Derivation.File.decode_render_of_captureFunctional
    (hfunctional : Triptych.GrammarCaptureFunctional Dimacs.grammar) (d : Dimacs.Derivation.File)
    (hvalid : Dimacs.Derivation.File.Valid d) :
    Triptych.decode Dimacs.grammar (Dimacs.Derivation.File.render d) =
      some (Dimacs.Derivation.File.capturesWith "" d) :=
  Triptych.decode_eq_of_mem_fullParses hfunctional (mem_fullParses d hvalid)

theorem Dimacs.decodeView_input {s : String} {v : Dimacs.View} (h : Dimacs.decodeView s = some v) :
    Dimacs.View.input v = s := by
  unfold Dimacs.decodeView at h
  rw [Option.map_eq_some_iff] at h
  obtain ⟨m, _, hv⟩ := h
  subst v
  rfl

theorem Dimacs.Derivation.File.decodeView_render_of_captureFunctional
    (hfunctional : Triptych.GrammarCaptureFunctional Dimacs.grammar) (d : Dimacs.Derivation.File)
    (hvalid : Dimacs.Derivation.File.Valid d) :
    Dimacs.decodeView (Dimacs.Derivation.File.render d) = some (Dimacs.Derivation.File.toView d) :=
  by
  unfold Dimacs.decodeView Dimacs.Derivation.File.toView
  rw [Triptych.scan_eq_decode]
  rw [Dimacs.Derivation.File.decode_render_of_captureFunctional hfunctional d hvalid]
  rfl

theorem Dimacs.SatisfiesWfConstraints_of_decode {s : String} {m : Triptych.CaptureMap}
    (h : decode Dimacs.grammar s = some m) :
    Dimacs.SatisfiesWfConstraints s ↔
      Dimacs.WfConstraints ((Triptych.CaptureMap.toEnv m "Clause#count").getD "")
        ((Triptych.CaptureMap.toEnv m "Count").getD "")
        ((Triptych.CaptureMap.groups "Lit" ["Lit", "Sign", "Var", "NonZero", "Digits"] m).map fun segment =>
          (Triptych.CaptureMap.toEnv segment "Var").getD "")
        ((Triptych.CaptureMap.toEnv m "Vars").getD "") :=
  by
  unfold Dimacs.SatisfiesWfConstraints
  simp only [Triptych.component_eq_of_decode h "Clause#count", Triptych.component_eq_of_decode h "Count",
    Triptych.componentWith_eq_of_decode h
        (fun m =>
          (Triptych.CaptureMap.groups "Lit" ["Lit", "Sign", "Var", "NonZero", "Digits"] m).map fun segment =>
            (Triptych.CaptureMap.toEnv segment "Var").getD ""),
    Triptych.component_eq_of_decode h "Vars"]

theorem Dimacs.Internal.matchesRef.Text (fuel : Nat) (s : String) :
    matchesSym Dimacs.grammar (fuel + 1) (Sym.ref "Text") s ↔ Dimacs.IsWf.Text s :=
  by
  rw [matchesSym,
    show
      (Dimacs.grammar).prod? "Text" =
        some
          (Production.mk "Text"
            [[SymItem.mk (Sym.term (TokClass.noneOf (List.cons '\n' List.nil)) LenSpec.atLeastOne) false]])
      from rfl]
  dsimp only
  rw [matchesProd_single]
  unfold Dimacs.IsWf.Text
  simp (config := { maxSteps := 1000000 }) only [Triptych.matchesSeq.eq_1, Triptych.matchesSeq.eq_2, exists_eq_left,
    ite_true, ite_false, Bool.false_eq_true, false_and, or_false, or_assoc, Triptych.matchesSym]
  simp (config := { maxSteps := 1000000 }) only [String.append_assoc, String.append_empty, exists_and_left, ← and_assoc,
    exists_eq_left, exists_eq_left', exists_eq_right, and_true, exists_append_lit_left, Option.some.injEq, forall_eq']
  try grind [String.append_assoc, String.append_empty]

