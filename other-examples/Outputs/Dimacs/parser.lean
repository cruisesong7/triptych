  rw [← Dimacs.IsWfGrammar_equiv, ← decodeSome_iff_IsWf Dimacs.grammar (by decide)]
  unfold Dimacs.SatisfiesWfConstraints Dimacs.WfConstraints Dimacs.constraints
  simp only [Triptych.component, Triptych.componentList, Triptych.componentWith, Triptych.envOf, Triptych.captureMapOf,
    Triptych.scan_eq_decode, List.forall_mem_cons, List.forall_mem_singleton, List.not_mem_nil, forall_const,
    ConstraintEntry.wfPart, Constraint.eval, ValExpr.eval, presentCount, natOf_getD, intOf_getD, lenOf_getD,
    countOf_getD, signOf_getD, hexOf_getD, hexSeqOf_getD, segmentsOf_getD, Env.countVal, and_true, true_and,
    false_implies, implies_true, Bool.false_eq_true]
  try grind

theorem Dimacs.IsValid_equiv (s : String) :
    Dimacs.IsValid s ↔
      Triptych.isWf Dimacs.grammar Dimacs.constraints s ∧
        Triptych.satisfiesConstraints Dimacs.grammar Dimacs.constraints s :=
  by
  unfold Dimacs.IsValid
  rw [(Dimacs.IsWf_equiv s)]
  unfold Triptych.satisfiesConstraints Triptych.captureMapOf Dimacs.constraints
  simp only [List.forall_mem_cons, List.forall_mem_singleton, List.not_mem_nil, ConstraintEntry.valPart, false_implies,
    true_and, and_true]
  constructor
  · intro h
    exact ⟨h, fun _ => True.intro⟩
  · exact And.left

instance Dimacs.instDecidableGrammar : DecidablePred Dimacs.IsWf.File := fun s =>
  @decidable_of_iff _ _ (Dimacs.IsWfGrammar_equiv s) (Triptych.decIsWfScanner Dimacs.grammar (by decide) s)

instance Dimacs.instDecidableIsWf : DecidablePred Dimacs.IsWf := fun s =>
  @decidable_of_iff _ _ (Dimacs.IsWf_equiv s).symm inferInstance

instance Dimacs.instDecidableIsValid : DecidablePred Dimacs.IsValid := fun s => inferInstance

theorem Dimacs.View.wfConstraints_of_decode {s : String} {m : Triptych.CaptureMap}
    (h : decode Dimacs.grammar s = some m) :
    Dimacs.SatisfiesWfConstraints s ↔ Dimacs.View.WfConstraints (Dimacs.View.ofMap s m) :=
  by
  rw [Dimacs.SatisfiesWfConstraints_of_decode h]
  rfl

theorem Dimacs.IsValid_view (s : String) :
    Dimacs.IsValid s ↔ ∃ v : Dimacs.View, Dimacs.decodeView s = some v ∧ Dimacs.View.Valid v :=
  by
  constructor
  · intro hvalid
    have hengine := (Dimacs.IsValid_equiv s).mp hvalid
    have hsome : (decode Dimacs.grammar s).isSome = true := by simpa only [Triptych.scan_eq_decode] using hengine.1.1
    obtain ⟨m, hm⟩ := Option.isSome_iff_exists.mp hsome
    have hmDecode : decode Dimacs.grammar s = some m := hm
    refine ⟨Dimacs.View.ofMap s m, ?_, ?_⟩
    · unfold Dimacs.decodeView
      simp [Triptych.scan_eq_decode, hmDecode]
    · exact (Dimacs.View.wfConstraints_of_decode hmDecode).mp hvalid.2
  · rintro ⟨v, hview, hvalid⟩
    unfold Dimacs.decodeView at hview
    rw [Option.map_eq_some_iff] at hview
    obtain ⟨m, hm, hv⟩ := hview
    subst v
    have hmDecode : decode Dimacs.grammar s = some m := by simpa only [Triptych.scan_eq_decode] using hm
    have hdecoded : (decode Dimacs.grammar s).isSome = true := by simp [hmDecode]
    have hgrammar := (Dimacs.IsWfGrammar_equiv s).mp ((decodeSome_iff_IsWf Dimacs.grammar (by decide) s).mp hdecoded)
    exact ⟨hgrammar, (Dimacs.View.wfConstraints_of_decode hmDecode).mpr hvalid⟩

theorem Dimacs.computeValue_eq (s : String) :
    Dimacs.computeValue s =
      (decode Dimacs.grammar s).map
        (fun _ =>
          Dimacs.value
            (Triptych.componentWith Dimacs.grammar s
              (fun m =>
                (Triptych.CaptureMap.groups "Clause"
                      ["Clause", "Lits", "Ws", "WsLit", "Lit", "Sign", "Var", "NonZero", "Digits", "WsLit#count"] m).map
                  fun segment =>
                  (Triptych.CaptureMap.groups "Lit" ["Lit", "Sign", "Var", "NonZero", "Digits"] segment).map
                    fun segment =>
                    ((Triptych.CaptureMap.toEnv segment "Sign").getD "",
                      (Triptych.CaptureMap.toEnv segment "Var").getD "")))) :=
  by
  unfold Dimacs.computeValue Triptych.scannerComputeValueMap Triptych.componentWith Triptych.captureMapOf Dimacs.valueFn
    Dimacs.value
  rw [Triptych.scan_eq_decode]
  cases h : decode Dimacs.grammar s with
  | none => simp [h]
  | some m =>
    simp [h, natOf_getD, intOf_getD, lenOf_getD, countOf_getD, signOf_getD, hexOf_getD, hexSeqOf_getD, segmentsOf_getD,
        Env.countVal, ValExpr.eval] <;>
      ac_rfl

theorem Dimacs.computeValue_of_decode {s : String} {m : Triptych.CaptureMap} (h : decode Dimacs.grammar s = some m) :
    Dimacs.computeValue s =
      some
        (Dimacs.value
          ((Triptych.CaptureMap.groups "Clause"
                ["Clause", "Lits", "Ws", "WsLit", "Lit", "Sign", "Var", "NonZero", "Digits", "WsLit#count"] m).map
            fun segment =>
            (Triptych.CaptureMap.groups "Lit" ["Lit", "Sign", "Var", "NonZero", "Digits"] segment).map fun segment =>
              ((Triptych.CaptureMap.toEnv segment "Sign").getD "",
                (Triptych.CaptureMap.toEnv segment "Var").getD ""))) :=
  by
  rw [Dimacs.computeValue_eq, h]
  simp only [Option.map_some,
    Triptych.componentWith_eq_of_decode h
        (fun m =>
          (Triptych.CaptureMap.groups "Clause"
                ["Clause", "Lits", "Ws", "WsLit", "Lit", "Sign", "Var", "NonZero", "Digits", "WsLit#count"] m).map
            fun segment =>
            (Triptych.CaptureMap.groups "Lit" ["Lit", "Sign", "Var", "NonZero", "Digits"] segment).map fun segment =>
              ((Triptych.CaptureMap.toEnv segment "Sign").getD "", (Triptych.CaptureMap.toEnv segment "Var").getD ""))]

theorem Dimacs.computeValue_view (s : String) :
    Dimacs.computeValue s = (Dimacs.decodeView s).map Dimacs.View.denotation :=
  by
  unfold Dimacs.decodeView
  rw [Triptych.scan_eq_decode]
  cases h : decode Dimacs.grammar s with
  |
    none =>
    rw [show Dimacs.computeValue s = none by
        rw [Dimacs.computeValue_eq, h]
        rfl]
    rfl
  | some m =>
    rw [Dimacs.computeValue_of_decode h]
    simp only [Option.map_some]
    rfl

/- ═══════════════════════════════ parser ══════════════════════════════
The generated correct-by-construction parser `parse` uses a certified staged cursor
program when the grammar supports one, projects its captures once into the typed
`View`, checks `View.Valid`, and computes `View.denotation`. Certified cursor rejection
is final; grammar
shapes outside that fragment use the complete scanner. `parse_eq_scanner` and
`parse_eq_gated` prove equality with the generic
scanner and readable validity-gated presentation. Its correctness and search-cost
guarantees — `parse_sound`, `parse_complete`, `parse_reject`,
`parse_profile_result`, `parse_candidateChecks_le`, `parse_view`, and typed
`parse_eq_some_iff_view` / `parse_eq_none_iff_view` normal forms — are all
AUTO-DISCHARGED here.
When an external parser is declared, `checkedExtParse` additionally validates each
external result against this parser and ships an AUTO-DISCHARGED soundness theorem.
A verified parser, no `sorry`. -/

