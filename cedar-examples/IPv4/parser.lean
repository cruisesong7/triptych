theorem IPv4.decodeView_input {s : String} {v : IPv4.View} (h : IPv4.decodeView s = some v) : IPv4.View.input v = s :=
  by
  unfold IPv4.decodeView at h
  rw [Option.map_eq_some_iff] at h
  obtain ⟨m, _, hv⟩ := h
  subst v
  rfl

