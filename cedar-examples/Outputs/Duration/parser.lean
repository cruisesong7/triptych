theorem Duration.Derivation.Components.matches (qual : String) (fuel : Nat) (d : Duration.Derivation.Components)
    (hvalid : Duration.Derivation.Components.Valid d) :
    Triptych.ProdMatch Duration.grammar qual (fuel + 3)
      (Production.mk "Components"
        [[SymItem.mk (Sym.ref "Days") true, SymItem.mk (Sym.ref "Hours") true, SymItem.mk (Sym.ref "Minutes") true,
            SymItem.mk (Sym.ref "Seconds") true, SymItem.mk (Sym.ref "Millis") true]])
      (Duration.Derivation.Components.render d) (Duration.Derivation.Components.capturesWith qual d) :=
  by
  cases d with
  | alt0 part0 part1 part2 part3
    part4 =>
    simp only [Duration.Derivation.Components.Valid] at hvalid
    rcases hvalid with ⟨hpart0, hpart1, hpart2, hpart3, hpart4⟩
    simp only [Duration.Derivation.Components.render, Duration.Derivation.Components.capturesWith]
    apply
      Triptych.prodMatch_of_alt (alt :=
        [SymItem.mk (Sym.ref "Days") true, SymItem.mk (Sym.ref "Hours") true, SymItem.mk (Sym.ref "Minutes") true,
          SymItem.mk (Sym.ref "Seconds") true, SymItem.mk (Sym.ref "Millis") true])
    · simp
    ·
      exact
        (by
          apply Triptych.seqMatch_optional (valid := fun entry => Duration.Derivation.Days.Valid entry)
          · exact hpart0
          · intro entry hentry
            exact
              (by
                simpa only [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
                  (Triptych.symMatch_ref Duration.grammar qual (((fuel + 0)) + 2) "Days"
                    (Production.mk "Days" [[SymItem.mk (Sym.ref "DDays") false, SymItem.mk (Sym.lit "d") false]])
