                          (Duration.Derivation.Hours.capturesWith "Hours" entry)
                          (Duration.Derivation.Hours.matches "Hours" (fuel + 0) entry hentry)))
                ·
                  exact
                    (by
                      apply Triptych.seqMatch_optional (valid := fun entry => Duration.Derivation.Minutes.Valid entry)
                      · exact hpart2
                      · intro entry hentry
                        exact
                          (by
                            simpa only [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
                              (Triptych.symMatch_ref Duration.grammar qual (((fuel + 0)) + 2) "Minutes"
                                (Production.mk "Minutes"
                                  [[SymItem.mk (Sym.ref "DMinutes") false, SymItem.mk (Sym.lit "m") false]])
                                (by rfl) (Duration.Derivation.Minutes.render entry)
                                (Duration.Derivation.Minutes.capturesWith "Minutes" entry)
                                (Duration.Derivation.Minutes.matches "Minutes" (fuel + 0) entry hentry)))
                      ·
                        exact
                          (by
                            apply
                              Triptych.seqMatch_optional (valid := fun entry => Duration.Derivation.Seconds.Valid entry)
                            · exact hpart3
                            · intro entry hentry
                              exact
                                (by
                                  simpa only [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
                                    (Triptych.symMatch_ref Duration.grammar qual (((fuel + 0)) + 2) "Seconds"
                                      (Production.mk "Seconds"
                                        [[SymItem.mk (Sym.ref "DSeconds") false, SymItem.mk (Sym.lit "s") false]])
                                      (by rfl) (Duration.Derivation.Seconds.render entry)
                                      (Duration.Derivation.Seconds.capturesWith "Seconds" entry)
                                      (Duration.Derivation.Seconds.matches "Seconds" (fuel + 0) entry hentry)))
                            ·
                              exact
                                (by
                                  apply
                                    Triptych.seqMatch_optional (valid := fun entry =>
                                      Duration.Derivation.Millis.Valid entry)
                                  · exact hpart4
                                  · intro entry hentry
                                    exact
