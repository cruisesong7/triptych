private theorem Duration.directDecode_eq_searchProgram (source : String) :
    Duration.directDecode source = SearchProgram.decode Duration.searchProgram source :=
  by
  unfold Duration.directDecode SearchProgram.decode Duration.searchProgram
  simp only [SearchCode.runK]

private def Duration.decodeCaptures (source : String) : Option CaptureMap :=
  Duration.directDecode source

private theorem Duration.decodeCaptures_eq_parsePlan (source : String) :
    Duration.decodeCaptures source = ParsePlan.decode Duration.parsePlan Duration.grammar source := by
  calc
    Duration.decodeCaptures source = SearchProgram.decode Duration.searchProgram source := by
      exact Duration.directDecode_eq_searchProgram source
    _ = SearchProgram.decode (lowerSearchPlan Duration.searchPlan) source := by rw [Duration.searchProgram_lowered]
    _ = ParsePlan.decode Duration.parsePlan Duration.grammar source := by rfl

private theorem Duration.decodeCaptures_eq_scan (source : String) :
    Duration.decodeCaptures source = scan Duration.grammar source := by
  calc
    Duration.decodeCaptures source = ParsePlan.decode Duration.parsePlan Duration.grammar source :=
      Duration.decodeCaptures_eq_parsePlan source
    _ = scan Duration.grammar source :=
      ParsePlan.decode_eq_scan (ParsePlan.CertifiedFor.search Duration.searchPlan_mirrorsGrammar) source

private def Duration.directView (source : String) : Option Duration.View :=
  (Duration.directDecode source).map (Duration.View.ofMap source)

private theorem Duration.directView_eq_decodeView (source : String) :
    Duration.directView source = Duration.decodeView source :=
  by
  unfold Duration.directView Duration.decodeView
  rw [show Duration.directDecode source = scan Duration.grammar source by exact Duration.decodeCaptures_eq_scan source]

private instance Duration.instDecidableViewValid : DecidablePred Duration.View.Valid := fun view =>
  by
  unfold Duration.View.Valid Duration.View.WfConstraints Duration.View.Constraints Duration.WfConstraints
    Duration.Constraints
  infer_instance

private def Duration.fastAccept (view : Duration.View) (computed : Int) : Bool :=
  @decide (Duration.View.WfConstraints view ∧ Duration.View.ConstraintsWithValue view computed)
    (by
      unfold Duration.View.WfConstraints Duration.WfConstraints Duration.View.ConstraintsWithValue
      infer_instance)

private theorem Duration.fastAccept_denotation (view : Duration.View) :
    Duration.fastAccept view (Duration.View.denotation view) = true ↔ Duration.View.Valid view := by
  simp only [Duration.fastAccept, decide_eq_true_eq, Duration.View.ConstraintsWithValue_denotation]

theorem Duration.computeValue_isSome (s : String) : Duration.IsValid s → (Duration.computeValue s).isSome :=
  by
  intro h
  have hengine := (Duration.IsValid_equiv s).mp h
  unfold Triptych.isWf at hengine
  unfold Duration.computeValue Triptych.scannerComputeValue
  rw [Option.isSome_map]
  exact hengine.1.1

def Duration.parse (s : String) :=
  Triptych.decodedViewParseCached Duration.directView Duration.fastAccept Duration.View.denotation millisToDuration s

theorem Duration.parse_eq_scanner (s : String) :
    Duration.parse s =
      Triptych.scannerParse Duration.grammar Duration.constraints Duration.valueExpr millisToDuration s :=
  by
  calc
    Duration.parse s =
        Triptych.decodedViewParse Duration.directView Duration.View.Valid Duration.View.denotation millisToDuration s :=
      by
      unfold Duration.parse
      exact
        Triptych.decodedViewParseCached_eq_decodedViewParse Duration.directView Duration.fastAccept Duration.View.Valid
          Duration.View.denotation millisToDuration Duration.fastAccept_denotation s
    _ = Triptych.gatedParseOfSpec Duration.IsValid Duration.computeValue millisToDuration s := by
      exact
        Triptych.decodedViewParse_eq_gatedParseOfSpec Duration.directView Duration.decodeView Duration.View.Valid
          Duration.View.denotation millisToDuration Duration.IsValid Duration.computeValue
          Duration.directView_eq_decodeView Duration.IsValid_view Duration.computeValue_view s
    _ = Triptych.scannerParse Duration.grammar Duration.constraints Duration.valueExpr millisToDuration s :=
      by
      symm
      unfold Duration.computeValue
      exact
        Triptych.scannerParse_eq_surfaceGatedParseOfSpec Duration.grammar Duration.constraints Duration.valueExpr
          millisToDuration Duration.IsValid Duration.IsValid_equiv s

theorem Duration.parse_eq_gated (s : String) :
    Duration.parse s = Triptych.gatedParseOfSpec Duration.IsValid Duration.computeValue millisToDuration s :=
  by
  rw [Duration.parse_eq_scanner]
  unfold Duration.computeValue
  exact
    Triptych.scannerParse_eq_surfaceGatedParseOfSpec Duration.grammar Duration.constraints Duration.valueExpr
      millisToDuration Duration.IsValid Duration.IsValid_equiv s

theorem Duration.parse_profile_result (s : String) :
    (Triptych.scannerParseProfile Duration.grammar Duration.constraints Duration.valueExpr millisToDuration s).result =
      Duration.parse s :=
  by
  rw [Triptych.scannerParseProfile_result]
  exact (Duration.parse_eq_scanner s).symm

theorem Duration.parse_candidateChecks_le (s : String) :
    (Triptych.scannerParseProfile Duration.grammar Duration.constraints Duration.valueExpr millisToDuration
          s).candidateChecks ≤
      Triptych.scannerCandidateBudget Duration.grammar s :=
  Triptych.scannerParse_candidateChecks_le Duration.grammar Duration.constraints Duration.valueExpr millisToDuration s

theorem Duration.parse_candidateChecks_eq_zero_of_fastScan (s : String)
    (hunique : (Duration.grammar).staticUnique = true) {captures : Triptych.CaptureMap}
    (hscan : Triptych.fastScan Duration.grammar s = some captures) :
    (Triptych.scannerParseProfile Duration.grammar Duration.constraints Duration.valueExpr millisToDuration
          s).candidateChecks =
      0 :=
  Triptych.scannerParse_candidateChecks_eq_zero_of_fastScan Duration.grammar Duration.constraints Duration.valueExpr
    millisToDuration s hunique hscan

theorem Duration.parse_sound (s : String) (d : Cedar.Spec.Ext.Datetime.Duration) :
    Duration.parse s = some d → Duration.IsValid s ∧ (Duration.computeValue s).map millisToDuration = some d :=
  by
  rw [Duration.parse_eq_gated]
  exact Triptych.gatedParseOfSpec_sound _ _ _ s d

theorem Duration.parse_complete (s : String) (d : Cedar.Spec.Ext.Datetime.Duration) :
    Duration.IsValid s → (Duration.computeValue s).map millisToDuration = some d → Duration.parse s = some d :=
  by
  rw [Duration.parse_eq_gated]
  exact Triptych.gatedParseOfSpec_complete _ _ _ s d

theorem Duration.parse_reject (s : String) : Duration.parse s = none ↔ ¬Duration.IsValid s :=
  by
  rw [Duration.parse_eq_gated]
  exact Triptych.gatedParseOfSpec_reject _ _ _ Duration.computeValue_isSome s

theorem Duration.parse_view (s : String) :
    Duration.parse s =
      if decide (Duration.IsValid s) then (Duration.decodeView s).map (millisToDuration ∘ Duration.View.denotation)
      else none :=
  by
  rw [Duration.parse_eq_gated]
  unfold Triptych.gatedParseOfSpec Triptych.gatedParse
  rw [Duration.computeValue_view]
  split <;> simp [Option.map_map]

theorem Duration.parse_eq_some_iff_view (s : String) (d : Cedar.Spec.Ext.Datetime.Duration) :
    Duration.parse s = some d ↔
      ∃ decodedView : Duration.View,
        Duration.decodeView s = some decodedView ∧
          Duration.View.Valid decodedView ∧ millisToDuration (Duration.View.denotation decodedView) = d :=
  by
  constructor
  · intro hparse
    obtain ⟨hvalid, hvalue⟩ := Duration.parse_sound s d hparse
    obtain ⟨decodedView, hview, hvalidView⟩ := (Duration.IsValid_view s).mp hvalid
    refine ⟨decodedView, hview, hvalidView, ?_⟩
    rw [Duration.computeValue_view, hview] at hvalue
    simpa using Option.some.inj hvalue
  · rintro ⟨decodedView, hview, hvalidView, hvalue⟩
    apply Duration.parse_complete s d
    · exact (Duration.IsValid_view s).mpr ⟨decodedView, hview, hvalidView⟩
    · rw [Duration.computeValue_view, hview]
      simpa using congrArg some hvalue

theorem Duration.parse_eq_none_iff_view (s : String) :
    Duration.parse s = none ↔ ¬∃ v : Duration.View, Duration.decodeView s = some v ∧ Duration.View.Valid v :=
  by
  rw [Duration.parse_reject]
  constructor
  · intro hinvalid ⟨v, hview, hvalidView⟩
    exact hinvalid ((Duration.IsValid_view s).mpr ⟨v, hview, hvalidView⟩)
  · intro hnoview hvalid
    exact hnoview ((Duration.IsValid_view s).mp hvalid)

def Duration.checkedExtParse (s : String) : Option Cedar.Spec.Ext.Datetime.Duration :=
  Triptych.checkedExternalParse Duration.IsValid Duration.computeValue Cedar.Spec.Ext.Datetime.Duration.parse
    durationMillis s

theorem Duration.checkedExtParse_eq_some_iff (s : String) (d : Cedar.Spec.Ext.Datetime.Duration) :
    Duration.checkedExtParse s = some d ↔
      Cedar.Spec.Ext.Datetime.Duration.parse s = some d ∧
        Duration.IsValid s ∧ Duration.computeValue s = some (durationMillis d) :=
  Triptych.checkedExternalParse_eq_some_iff Duration.IsValid Duration.computeValue
    Cedar.Spec.Ext.Datetime.Duration.parse durationMillis s d

theorem Duration.checkedExtParse_sound (s : String) (d : Cedar.Spec.Ext.Datetime.Duration) :
    Duration.checkedExtParse s = some d → Duration.IsValid s ∧ Duration.computeValue s = some (durationMillis d) :=
  Triptych.checkedExternalParse_sound Duration.IsValid Duration.computeValue Cedar.Spec.Ext.Datetime.Duration.parse
    durationMillis s d

theorem Duration.checkedExtParse_sound_view (s : String) (d : Cedar.Spec.Ext.Datetime.Duration) :
    Duration.checkedExtParse s = some d →
      ∃ v : Duration.View,
        Duration.decodeView s = some v ∧ Duration.View.Valid v ∧ Duration.View.denotation v = durationMillis d :=
  by
  intro hparse
  obtain ⟨hvalid, hvalue⟩ := Duration.checkedExtParse_sound s d hparse
  obtain ⟨v, hview, hvalidView⟩ := (Duration.IsValid_view s).mp hvalid
  refine ⟨v, hview, hvalidView, ?_⟩
  rw [Duration.computeValue_view, hview] at hvalue
  exact Option.some.inj hvalue
