                    (Duration.Derivation.Days.capturesWith "Days" entry)
                    (Duration.Derivation.Days.matches "Days" (fuel + 0) entry hentry)))
          ·
            exact
              (by
                apply Triptych.seqMatch_optional (valid := fun entry => Duration.Derivation.Hours.Valid entry)
                · exact hpart1
                · intro entry hentry
                  exact
                    (by
                      simpa only [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
