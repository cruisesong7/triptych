theorem IPv6.View.wfConstraints_of_decode {s : String} {m : Triptych.CaptureMap} (h : decode IPv6.grammar s = some m) :
    IPv6.SatisfiesWfConstraints s ↔ IPv6.View.WfConstraints (IPv6.View.ofMap s m) :=
