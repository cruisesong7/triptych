    Triptych.ProdMatch IPv6.grammar qual (fuel + 5)
      (Production.mk "V6Net"
        [[SymItem.mk (Sym.ref "V6Addr") false],
          [SymItem.mk (Sym.ref "V6Addr") false, SymItem.mk (Sym.lit "/") false, SymItem.mk (Sym.ref "Prefix") false]])
      (IPv6.Derivation.V6Net.render d) (IPv6.Derivation.V6Net.capturesWith qual d) :=
  by
  cases d with
  | alt0 part0 =>
    simp only [IPv6.Derivation.V6Net.Valid] at hvalid
    have hpart0 := hvalid
    simp only [IPv6.Derivation.V6Net.render, IPv6.Derivation.V6Net.capturesWith]
    apply Triptych.prodMatch_of_alt (alt := [SymItem.mk (Sym.ref "V6Addr") false])
    · simp
    ·
      exact
        (by
          apply Triptych.seqMatch_required
          ·
            exact
              (by
                simpa only [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
                  (Triptych.symMatch_ref IPv6.grammar qual (((fuel + 0)) + 4) "V6Addr"
                    (Production.mk "V6Addr"
                      [[SymItem.mk (Sym.ref "Full") false], [SymItem.mk (Sym.ref "Compressed") false]])
                    (by rfl) (IPv6.Derivation.V6Addr.render part0) (IPv6.Derivation.V6Addr.capturesWith "V6Addr" part0)
                    (IPv6.Derivation.V6Addr.matches "V6Addr" (fuel + 0) part0 hpart0)))
          · exact Triptych.seqMatch_nil IPv6.grammar qual (fuel + 5))
  | alt1 part0 part2 =>
    simp only [IPv6.Derivation.V6Net.Valid] at hvalid
    rcases hvalid with ⟨hpart0, hpart2⟩
    simp only [IPv6.Derivation.V6Net.render, IPv6.Derivation.V6Net.capturesWith]
    apply
      Triptych.prodMatch_of_alt (alt :=
        [SymItem.mk (Sym.ref "V6Addr") false, SymItem.mk (Sym.lit "/") false, SymItem.mk (Sym.ref "Prefix") false])
    · simp
    ·
      exact
        (by
          apply Triptych.seqMatch_required
          ·
            exact
              (by
                simpa only [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
                  (Triptych.symMatch_ref IPv6.grammar qual (((fuel + 0)) + 4) "V6Addr"
                    (Production.mk "V6Addr"
                      [[SymItem.mk (Sym.ref "Full") false], [SymItem.mk (Sym.ref "Compressed") false]])
                    (by rfl) (IPv6.Derivation.V6Addr.render part0) (IPv6.Derivation.V6Addr.capturesWith "V6Addr" part0)
                    (IPv6.Derivation.V6Addr.matches "V6Addr" (fuel + 0) part0 hpart0)))
          ·
            exact
              (by
                apply Triptych.seqMatch_required
                · exact Triptych.symMatch_lit IPv6.grammar qual (fuel + 5) "/"
                ·
                  exact
                    (by
                      apply Triptych.seqMatch_required
                      ·
                        exact
                          (by
                            simpa only [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
                              (Triptych.symMatch_ref IPv6.grammar qual (((fuel + 3)) + 1) "Prefix"
                                (Production.mk "Prefix"
                                  [[SymItem.mk (Sym.term TokClass.digit (LenSpec.between 1 3)) false]])
                                (by rfl) (IPv6.Derivation.Prefix.render part2)
                                (IPv6.Derivation.Prefix.capturesWith "Prefix" part2)
                                (IPv6.Derivation.Prefix.matches "Prefix" (fuel + 3) part2 hpart2)))
                      · exact Triptych.seqMatch_nil IPv6.grammar qual (fuel + 5))))

theorem IPv6.Derivation.V6Net.mem_fullParses (d : IPv6.Derivation.V6Net) (hvalid : IPv6.Derivation.V6Net.Valid d) :
    IPv6.Derivation.V6Net.capturesWith "" d ∈ Triptych.fullParses IPv6.grammar (IPv6.Derivation.V6Net.render d) :=
  by
  apply
    Triptych.prodMatch_mem_fullParses IPv6.grammar
      (Production.mk "V6Net"
        [[SymItem.mk (Sym.ref "V6Addr") false],
          [SymItem.mk (Sym.ref "V6Addr") false, SymItem.mk (Sym.lit "/") false, SymItem.mk (Sym.ref "Prefix") false]])
      (by rfl)
  simpa [IPv6.grammar] using (IPv6.Derivation.V6Net.matches "" 5 d hvalid)

theorem IPv6.Derivation.V6Net.decode_render_of_captureFunctional
    (hfunctional : Triptych.GrammarCaptureFunctional IPv6.grammar) (d : IPv6.Derivation.V6Net)
    (hvalid : IPv6.Derivation.V6Net.Valid d) :
    Triptych.decode IPv6.grammar (IPv6.Derivation.V6Net.render d) = some (IPv6.Derivation.V6Net.capturesWith "" d) :=
  Triptych.decode_eq_of_mem_fullParses hfunctional (mem_fullParses d hvalid)

theorem IPv6.decodeView_input {s : String} {v : IPv6.View} (h : IPv6.decodeView s = some v) : IPv6.View.input v = s :=
  by
  unfold IPv6.decodeView at h
  rw [Option.map_eq_some_iff] at h
  obtain ⟨m, _, hv⟩ := h
  subst v
  rfl

theorem IPv6.Derivation.V6Net.decodeView_render_of_captureFunctional
    (hfunctional : Triptych.GrammarCaptureFunctional IPv6.grammar) (d : IPv6.Derivation.V6Net)
    (hvalid : IPv6.Derivation.V6Net.Valid d) :
