    none =>
    rw [show IPv6.computeValue s = none by
        rw [IPv6.computeValue_eq, h]
        rfl]
    rfl
  | some m =>
    rw [IPv6.computeValue_of_decode h]
    simp only [Option.map_some]
    rfl

