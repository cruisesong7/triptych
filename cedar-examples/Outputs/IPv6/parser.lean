theorem IPv6.IsWfGrammar_equiv (s : String) : Triptych.IsWf IPv6.grammar s ↔ IPv6.Production s :=
  by
  rw [isWf_eq_isWfProd_start, IsWfProd,
    show
      (IPv6.grammar).prod? (IPv6.grammar).start =
        some
          (Production.mk "V6Net"
            [[SymItem.mk (Sym.ref "V6Addr") false],
              [SymItem.mk (Sym.ref "V6Addr") false, SymItem.mk (Sym.lit "/") false,
                SymItem.mk (Sym.ref "Prefix") false]])
      from rfl]
  have hstart :
    ∀ n,
      matchesProd IPv6.grammar n
          (Production.mk "V6Net"
            [[SymItem.mk (Sym.ref "V6Addr") false],
              [SymItem.mk (Sym.ref "V6Addr") false, SymItem.mk (Sym.lit "/") false,
                SymItem.mk (Sym.ref "Prefix") false]])
          s =
        matchesSym IPv6.grammar (n + 1) (Sym.ref "V6Net") s :=
    by
    intro n
    rw [matchesSym,
      show
        (IPv6.grammar).prod? "V6Net" =
          some
            (Production.mk "V6Net"
              [[SymItem.mk (Sym.ref "V6Addr") false],
                [SymItem.mk (Sym.ref "V6Addr") false, SymItem.mk (Sym.lit "/") false,
                  SymItem.mk (Sym.ref "Prefix") false]])
        from rfl]
  show
    matchesProd IPv6.grammar (IPv6.grammar).prods.length
        (Production.mk "V6Net"
          [[SymItem.mk (Sym.ref "V6Addr") false],
            [SymItem.mk (Sym.ref "V6Addr") false, SymItem.mk (Sym.lit "/") false, SymItem.mk (Sym.ref "Prefix") false]])
        s ↔
      _
  rw [hstart]
  exact IPv6.Internal.matchesRef.V6Net _ s

