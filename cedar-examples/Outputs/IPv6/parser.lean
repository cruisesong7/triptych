theorem IPv6.IsValid_equiv (s : String) :
    IPv6.IsValid s ↔
      Triptych.isWf IPv6.grammar IPv6.constraints s ∧ Triptych.satisfiesConstraints IPv6.grammar IPv6.constraints s :=
