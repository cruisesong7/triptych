      (decode IPv6.grammar s).map
        (fun _ =>
          IPv6.value (Triptych.component IPv6.grammar s "Full") (Triptych.component IPv6.grammar s "Left")
            (Triptych.component IPv6.grammar s "Right") (Triptych.component IPv6.grammar s "Prefix")) :=
