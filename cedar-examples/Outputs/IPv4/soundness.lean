  · rintro ⟨decodedView, hview, hvalidView, hvalue⟩
    apply IPv4.extparse_complete s i
    · exact (IPv4.IsValid_view s).mpr ⟨decodedView, hview, hvalidView⟩
    · rw [IPv4.computeValue_view, hview]
