  fun hvalid hvalue => (IPv4.RuleRegistrySoundness.parser_agrees s i).mpr ⟨hvalid, hvalue⟩

theorem IPv4.extparse_eq_some_iff_view (s : String) (i : CedarExamples.IPv4.IPv4Net) :
    ipv4Only s = some i ↔
      ∃ decodedView : IPv4.View,
