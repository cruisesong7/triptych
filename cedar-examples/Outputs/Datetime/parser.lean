        (Datetime.grammar).prod? "Datetime" =
          some
            (Production.mk "Datetime"
              [[SymItem.mk (Sym.ref "Date") false],
                [SymItem.mk (Sym.ref "Date") false, SymItem.mk (Sym.lit "T") false, SymItem.mk (Sym.ref "Time") false,
