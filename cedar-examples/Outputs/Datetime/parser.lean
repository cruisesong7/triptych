theorem Datetime.Derivation.Datetime.decode_render_of_captureFunctional
    (hfunctional : Triptych.GrammarCaptureFunctional Datetime.grammar) (d : Datetime.Derivation.Datetime)
    (hvalid : Datetime.Derivation.Datetime.Valid d) :
    Triptych.decode Datetime.grammar (Datetime.Derivation.Datetime.render d) =
