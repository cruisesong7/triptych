theorem Datetime.Derivation.Datetime.mem_fullParses (d : Datetime.Derivation.Datetime)
    (hvalid : Datetime.Derivation.Datetime.Valid d) :
    Datetime.Derivation.Datetime.capturesWith "" d ∈
      Triptych.fullParses Datetime.grammar (Datetime.Derivation.Datetime.render d) :=
  by
  apply
    Triptych.prodMatch_mem_fullParses Datetime.grammar
      (Production.mk "Datetime"
        [[SymItem.mk (Sym.ref "Date") false],
          [SymItem.mk (Sym.ref "Date") false, SymItem.mk (Sym.lit "T") false, SymItem.mk (Sym.ref "Time") false,
            SymItem.mk (Sym.lit "Z") false],
