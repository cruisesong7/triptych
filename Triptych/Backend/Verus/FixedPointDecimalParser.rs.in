pub const DECIMAL_NATURAL_LIMIT: u64 = 922_337_203_685_477;

pub open spec fn __SEMANTIC_PARSE_PLAN__(input: Seq<char>) -> Option<int> {
    match __PARSE_PLAN__(input) {
        Some(parsed) => {
            let view = __PARSE_VIEW__(input, parsed);
            if __VIEW_VALID__(view) {
                Some(__VIEW_DENOTATION__(view))
            } else {
                None
            }
        },
        None => None,
    }
}

pub proof fn __SEMANTIC_PARSE_PLAN_IFF_VALID__(
    input: Seq<char>,
    parsed: __PARSE_SPEC_TYPE__,
)
    requires
        __PARSE_PLAN__(input) == Some(parsed),
        __MATCHES_VIEW__(input, __PARSE_VIEW__(input, parsed)),
    ensures
        __SEMANTIC_PARSE_PLAN__(input).is_some() <==> __IS_VALID__(input),
{
    let canonical = __PARSE_VIEW__(input, parsed);
    reveal(__SEMANTIC_PARSE_PLAN__);
    reveal(__IS_VALID__);
    reveal(__IS_WF__);
    reveal(__SATISFIES_CONSTRAINTS__);
    reveal(__VIEW_VALID__);
    if __VIEW_CONSTRAINTS__(canonical) {
        assert(exists|view: __VIEW_TYPE__|
            __MATCHES_VIEW__(input, view) && __VIEW_CONSTRAINTS__(view)) by {
            assert(
                __MATCHES_VIEW__(input, canonical)
                    && __VIEW_CONSTRAINTS__(canonical)
            );
        }
    } else if __IS_VALID__(input) {
        let witness = choose|view: __VIEW_TYPE__|
            __MATCHES_VIEW__(input, view) && __VIEW_CONSTRAINTS__(view);
        __MATCHES_VIEW_PLAN__(input, witness);
        assert(witness.__SIGN__ == canonical.__SIGN__);
        assert(witness.__NATURAL__ == canonical.__NATURAL__);
        assert(witness.__FRACTION__ == canonical.__FRACTION__);
        assert(__VIEW_CONSTRAINTS__(witness) == __VIEW_CONSTRAINTS__(canonical)) by {
            reveal(__VIEW_CONSTRAINTS__);
            reveal(__VALUE__);
        }
        assert(false);
    }
}

fn decimal_parse_bounded_digits(
    input: &str,
    start: usize,
    end: usize,
    limit: u64,
) -> (result: Option<u64>)
    requires
        input.is_ascii(),
        start <= end <= input@.len(),
        limit <= DECIMAL_NATURAL_LIMIT,
        forall|index: int| start <= index < end ==>
            #[trigger] plan_token_accepts(PlanTokenClass::Digit, input@[index]),
    ensures
        match result {
            Some(value) =>
                triptych_nat_of(input@.subrange(start as int, end as int))
                    == value as int
                    && value <= limit,
            None =>
                (limit as int)
                    < triptych_nat_of(input@.subrange(start as int, end as int)),
        },
{
    let digits = Ghost(input@.subrange(start as int, end as int));
    let mut index = start;
    let mut value = 0u64;
    let mut overflow = false;
    let ghost mut exact = 0int;
    while index < end
        invariant
            input.is_ascii(),
            start <= index <= end <= input@.len(),
            limit <= DECIMAL_NATURAL_LIMIT,
            digits@ == input@.subrange(start as int, end as int),
            index - start <= digits@.len(),
            0 <= exact,
            triptych_nat_of(digits@)
                == triptych_nat_of_from(digits@, (index - start) as int, exact),
            overflow ==> (limit as int) < exact,
            !overflow ==> exact == (value as int) && value <= limit,
            forall|offset: int| 0 <= offset < digits@.len() ==>
                #[trigger] plan_token_accepts(PlanTokenClass::Digit, digits@[offset]),
        decreases end - index,
    {
        let byte = plan_ascii_character_at(input, index);
        assert(plan_token_accepts(PlanTokenClass::Digit, input@[index as int]));
        reveal(plan_token_accepts);
        let digit = byte - b'0';
        assert(digit <= 9);
        let ghost next_exact = exact * 10 + digit as int;
        proof {
            let offset = (index - start) as int;
            assert(digits@[offset] == input@[index as int]);
            assert(
                (digits@[offset] as int) - (TRIPTYCH_ZERO as int) == (digit as int)
            );
            assert(
                triptych_nat_of_from(digits@, offset, exact)
                    == triptych_nat_of_from(digits@, offset + 1, next_exact)
            ) by {
                reveal(triptych_nat_of_from);
            }
        }
        if !overflow {
            assert(
                (value as int) * 10 + (digit as int) <= 9_223_372_036_854_779
            );
            let next = value * 10 + digit as u64;
            if limit < next {
                overflow = true;
            } else {
                value = next;
            }
        }
        proof {
            exact = next_exact;
        }
        index += 1;
    }
    proof {
        reveal(triptych_nat_of);
        assert(
            triptych_nat_of_from(digits@, digits@.len() as int, exact) == exact
        ) by {
            reveal(triptych_nat_of_from);
        }
    }
    if overflow {
        None
    } else {
        Some(value)
    }
}

pub proof fn decimal_four_digits_bound(digits: Seq<char>)
    requires
        digits.len() <= 4,
        forall|index: int| 0 <= index < digits.len() ==>
            #[trigger] triptych_is_digit(digits[index]),
    ensures
        triptych_nat_of(digits) <= 9999,
{
    assert(
        digits.len() == 0 || digits.len() == 1 || digits.len() == 2
            || digits.len() == 3 || digits.len() == 4
    );
    if digits.len() == 0 {
        reveal(triptych_nat_of);
        reveal(triptych_nat_of_from);
    } else if digits.len() == 1 {
        assert(triptych_is_digit(digits[0]));
        reveal(triptych_is_digit);
        reveal(triptych_nat_of);
        reveal_with_fuel(triptych_nat_of_from, 2);
    } else if digits.len() == 2 {
        assert(triptych_is_digit(digits[0]));
        assert(triptych_is_digit(digits[1]));
        reveal(triptych_is_digit);
        reveal(triptych_nat_of);
        reveal_with_fuel(triptych_nat_of_from, 3);
    } else if digits.len() == 3 {
        assert(triptych_is_digit(digits[0]));
        assert(triptych_is_digit(digits[1]));
        assert(triptych_is_digit(digits[2]));
        reveal(triptych_is_digit);
        reveal(triptych_nat_of);
        reveal_with_fuel(triptych_nat_of_from, 4);
    } else {
        assert(triptych_is_digit(digits[0]));
        assert(triptych_is_digit(digits[1]));
        assert(triptych_is_digit(digits[2]));
        assert(triptych_is_digit(digits[3]));
        reveal(triptych_is_digit);
        reveal(triptych_nat_of);
        reveal_with_fuel(triptych_nat_of_from, 5);
    }
}

/// Generated semantic proof core used by the contract-bearing external parser.
pub(crate) fn __SEMANTIC_PARSE__(input: &str) -> (result: Option<i64>)
    ensures
        match result {
            Some(value) =>
                __SEMANTIC_PARSE_PLAN__(input@) == Some(value as int)
                    && __IS_VALID__(input@)
                    && exists|view: __VIEW_TYPE__|
                        __MATCHES_VIEW__(input@, view)
                            && __VIEW_VALID__(view)
                            && __VIEW_DENOTATION__(view) == value as int,
            None =>
                __SEMANTIC_PARSE_PLAN__(input@).is_none()
                    && !__IS_VALID__(input@),
        },
{
    let parsed = match __PARSE_CANDIDATE__(input) {
        Some(parsed) => parsed,
        None => return None,
    };
    let fraction_digits = Ghost(
        input@.subrange(
            parsed.__FRACTION___start as int,
            parsed.__FRACTION___end as int,
        ),
    );
    proof {
        assert(fraction_digits@.len() <= 4);
        assert forall|index: int| 0 <= index < fraction_digits@.len() implies
            #[trigger] triptych_is_digit(fraction_digits@[index]) by {
            assert(plan_token_accepts(
                PlanTokenClass::Digit,
                input@[parsed.__FRACTION___start as int + index],
            ));
            reveal(plan_token_accepts);
        }
        decimal_four_digits_bound(fraction_digits@);
    }
    let fraction = match decimal_parse_bounded_digits(
        input,
        parsed.__FRACTION___start,
        parsed.__FRACTION___end,
        9999,
    ) {
        Some(value) => value,
        None => {
            assert(false);
            return None;
        },
    };
    let fraction_length = parsed.__FRACTION___end - parsed.__FRACTION___start;
    let fraction_multiplier = if fraction_length == 1 {
        1000u64
    } else if fraction_length == 2 {
        100u64
    } else if fraction_length == 3 {
        10u64
    } else {
        1u64
    };
    let scaled_fraction = fraction * fraction_multiplier;
    let natural = match decimal_parse_bounded_digits(
        input,
        parsed.__NATURAL___start,
        parsed.__NATURAL___end,
        DECIMAL_NATURAL_LIMIT,
    ) {
        Some(value) => value,
        None => {
            proof {
                let view = __PARSE_VIEW__(input@, parsed.deep_view());
                let natural_value = triptych_nat_of(view.__NATURAL__);
                let fraction_value = triptych_nat_of(view.__FRACTION__);
                assert(natural_value > DECIMAL_NATURAL_LIMIT);
                assert(fraction_value == fraction as int);
                assert(0 <= fraction_value);
                let negative =
                    parsed.__SIGN___start < parsed.__SIGN___end;
                assert(__MATCHES_VIEW__(input@, view));
                assert(__SIGN_WF__(view.__SIGN__)) by {
                    reveal(__MATCHES_VIEW__);
                }
                reveal(__SIGN_WF__);
                let sign_literal = choose|literal: Seq<char>|
                    view.__SIGN__ == literal
                        && (literal.len() == 0
                            || literal == seq![__SIGN_CHAR_LITERAL__]);
                assert(view.__SIGN__ == sign_literal);
                if negative {
                    assert(0 < view.__SIGN__.len()) by {
                        reveal(__PARSE_VIEW__);
                    }
                    assert(view.__SIGN__ == seq![__SIGN_CHAR_LITERAL__]);
                    assert(triptych_sign_of(view.__SIGN__) == -1) by {
                        reveal(triptych_sign_of);
                    }
                } else {
                    assert(view.__SIGN__.len() == 0) by {
                        reveal(__PARSE_VIEW__);
                    }
                    assert(triptych_sign_of(view.__SIGN__) == 1) by {
                        reveal(triptych_sign_of);
                    }
                }
                assert(1 <= fraction_length && fraction_length <= 4);
                reveal_with_fuel(triptych_int_pow, 5);
                if fraction_length == 1 {
                    assert(
                        triptych_int_pow(
                            10,
                            4 - view.__FRACTION__.len() as int,
                        ) == fraction_multiplier
                    );
                } else if fraction_length == 2 {
                    assert(
                        triptych_int_pow(
                            10,
                            4 - view.__FRACTION__.len() as int,
                        ) == fraction_multiplier
                    );
                } else if fraction_length == 3 {
                    assert(
                        triptych_int_pow(
                            10,
                            4 - view.__FRACTION__.len() as int,
                        ) == fraction_multiplier
                    );
                } else {
                    assert(fraction_length == 4);
                    assert(
                        triptych_int_pow(
                            10,
                            4 - view.__FRACTION__.len() as int,
                        ) == fraction_multiplier
                    );
                }
                reveal(__SEMANTIC_PARSE_PLAN__);
                reveal(__VIEW_VALID__);
                reveal(__VIEW_CONSTRAINTS__);
                reveal(__VIEW_DENOTATION__);
                reveal(__VALUE__);
                assert(
                    __VIEW_DENOTATION__(view)
                        == if negative {
                            -(natural_value * 10_000
                                + fraction_value * fraction_multiplier)
                        } else {
                            natural_value * 10_000
                                + fraction_value * fraction_multiplier
                        }
                );
                assert(
                    natural_value * 10_000
                        + fraction_value * fraction_multiplier
                        > 9_223_372_036_854_775_808
                );
                assert(!__VIEW_VALID__(view));
                assert(__SEMANTIC_PARSE_PLAN__(input@).is_none());
                __SEMANTIC_PARSE_PLAN_IFF_VALID__(input@, parsed.deep_view());
                assert(!__IS_VALID__(input@));
            }
            return None;
        },
    };
    let magnitude = natural * 10_000u64 + scaled_fraction;
    let negative = parsed.__SIGN___start < parsed.__SIGN___end;
    proof {
        let view = __PARSE_VIEW__(input@, parsed.deep_view());
        assert(__MATCHES_VIEW__(input@, view));
        assert(__SIGN_WF__(view.__SIGN__)) by {
            reveal(__MATCHES_VIEW__);
        }
        reveal(__SIGN_WF__);
        let sign_literal = choose|literal: Seq<char>|
            view.__SIGN__ == literal
                && (literal.len() == 0
                    || literal == seq![__SIGN_CHAR_LITERAL__]);
        assert(view.__SIGN__ == sign_literal);
        if negative {
            assert(0 < view.__SIGN__.len()) by {
                reveal(__PARSE_VIEW__);
            }
            assert(view.__SIGN__ == seq![__SIGN_CHAR_LITERAL__]);
            assert(triptych_sign_of(view.__SIGN__) == -1) by {
                reveal(triptych_sign_of);
            }
        } else {
            assert(view.__SIGN__.len() == 0) by {
                reveal(__PARSE_VIEW__);
            }
            assert(triptych_sign_of(view.__SIGN__) == 1) by {
                reveal(triptych_sign_of);
            }
        }
        assert(triptych_nat_of(view.__NATURAL__) == natural as int);
        assert(triptych_nat_of(view.__FRACTION__) == fraction as int);
        assert(1 <= fraction_length && fraction_length <= 4);
        reveal_with_fuel(triptych_int_pow, 5);
        if fraction_length == 1 {
            assert(
                triptych_int_pow(10, 4 - view.__FRACTION__.len() as int)
                    == fraction_multiplier
            );
        } else if fraction_length == 2 {
            assert(
                triptych_int_pow(10, 4 - view.__FRACTION__.len() as int)
                    == fraction_multiplier
            );
        } else if fraction_length == 3 {
            assert(
                triptych_int_pow(10, 4 - view.__FRACTION__.len() as int)
                    == fraction_multiplier
            );
        } else {
            assert(fraction_length == 4);
            assert(
                triptych_int_pow(10, 4 - view.__FRACTION__.len() as int)
                    == fraction_multiplier
            );
        }
        reveal(__VIEW_DENOTATION__);
        reveal(__VALUE__);
        assert(scaled_fraction as int
            == fraction as int * fraction_multiplier as int);
        assert(magnitude as int
            == natural as int * 10_000 + scaled_fraction as int);
        assert(
            __VIEW_DENOTATION__(view)
                == if negative { -(magnitude as int) } else { magnitude as int }
        );
    }
    let limit = if negative {
        9_223_372_036_854_775_808u64
    } else {
        9_223_372_036_854_775_807u64
    };
    if limit < magnitude {
        proof {
            let view = __PARSE_VIEW__(input@, parsed.deep_view());
            reveal(__SEMANTIC_PARSE_PLAN__);
            reveal(__VIEW_VALID__);
            reveal(__VIEW_CONSTRAINTS__);
            assert(!__VIEW_VALID__(view));
            assert(__SEMANTIC_PARSE_PLAN__(input@).is_none());
            __SEMANTIC_PARSE_PLAN_IFF_VALID__(input@, parsed.deep_view());
            assert(!__IS_VALID__(input@));
        }
        return None;
    }
    let value = if negative {
        if magnitude == 9_223_372_036_854_775_808u64 {
            i64::MIN
        } else {
            -(magnitude as i64)
        }
    } else {
        magnitude as i64
    };
    proof {
        let view = __PARSE_VIEW__(input@, parsed.deep_view());
        reveal(__SEMANTIC_PARSE_PLAN__);
        reveal(__VIEW_VALID__);
        reveal(__VIEW_DENOTATION__);
        reveal(__VALUE__);
        reveal(triptych_sign_of);
        reveal_with_fuel(triptych_int_pow, 5);
        assert(__SEMANTIC_PARSE_PLAN__(input@) == Some(value as int));
        reveal(__IS_VALID__);
        reveal(__IS_WF__);
        reveal(__SATISFIES_CONSTRAINTS__);
        assert(__IS_VALID__(input@));
        assert(exists|matched: __VIEW_TYPE__|
            __MATCHES_VIEW__(input@, matched)
                && __VIEW_VALID__(matched)
                && __VIEW_DENOTATION__(matched) == value as int) by {
            assert(__MATCHES_VIEW__(input@, view));
            assert(__VIEW_VALID__(view));
            assert(__VIEW_DENOTATION__(view) == value as int);
        }
    }
    Some(value)
}
