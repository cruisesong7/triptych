}

pub open spec fn search_close_count_capture(
    state: SearchStateSpec,
    key: CaptureKey,
    count: usize,
) -> Option<SearchStateSpec> {
    if state.markers.len() == 0 {
        None
    } else {
        let marker = state.markers.last();
        if marker.capture_count >= state.captures.len()
            || marker.second_capture_count >= state.captures.len()
            || state.captures[marker.capture_count as int].is_some()
            || state.captures[marker.second_capture_count as int].is_some()
        {
            None
        } else {
            let capture = RuntimeCapture {
                key,
                start: marker.start as usize,
                end: marker.start as usize,
                count,
                is_count: true,
            };
            Some(search_close_slots_state(state, Some(capture), None))
        }
    }
}

pub proof fn search_close_count_capture_preserves_checkpoint(
    checkpoint: SearchCheckpoint,
    original: SearchStateSpec,
    current: SearchStateSpec,
    key: CaptureKey,
    count: usize,
    closed: SearchStateSpec,
)
    requires
        search_checkpoint_matches(checkpoint, original, current),
        search_close_count_capture(current, key, count) == Some(closed),
        checkpoint.capture_length <= current.markers.last().capture_count,
        current.markers.last().capture_count
            < current.markers.last().second_capture_count,
        checkpoint.marker_length < current.markers.len(),
    ensures
        search_checkpoint_matches(checkpoint, original, closed),
{
    reveal(search_close_count_capture);
    let marker = current.markers.last();
    let capture = RuntimeCapture {
        key,
        start: marker.start as usize,
        end: marker.start as usize,
        count,
        is_count: true,
    };
    search_close_slots_preserves_checkpoint(
        checkpoint,
        original,
        current,
        Some(capture),
        None,
    );
}

#[inline(always)]
fn search_close_count_capture_exec(
    state: &mut SearchState,
    key: CaptureKey,
    count: usize,
    input_length: Ghost<nat>,
) -> (result: bool)
    requires
        search_state_bounded(old(state).deep_view(), input_length@),
        old(state).storage_well_formed(),
    ensures
        result ==> search_close_count_capture(old(state).deep_view(), key, count)
            == Some(final(state).deep_view())
            && search_state_bounded(final(state).deep_view(), input_length@)
            && final(state).storage_well_formed()
            && final(state).semantic_cache == old(state).semantic_cache,
        !result ==> search_close_count_capture(old(state).deep_view(), key, count).is_none()
            && final(state).deep_view() == old(state).deep_view()
            && final(state).storage_well_formed()
            && final(state).semantic_cache == old(state).semantic_cache,
{
    let original = Ghost(state.deep_view());
    if state.markers.len() == 0 {
        return false;
    }
    let marker = state.markers.get(state.markers.len() - 1);
    let capture = RuntimeCapture {
        key,
        start: marker.start,
        end: marker.start,
        count,
        is_count: true,
    };
    search_set_capture_exec(
        &mut state.captures,
        marker.capture_count,
        capture,
    );
    search_clear_capture_exec(&mut state.captures, marker.second_capture_count);
    state.markers.pop();
    proof {
        reveal(search_close_count_capture);
        assert(state.deep_view() == search_close_slots_state(
            original@,
            Some(capture),
            None,
        ));
        search_close_slots_state_bounded(
            original@,
            Some(capture),
            None,
            input_length@,
        );
    }
    true
}

#[inline(always)]
fn search_reopen_capture_one_exec(
    state: &mut SearchState,
    marker: SearchMarker,
    key: CaptureKey,
    original: Ghost<SearchStateSpec>,
)
    requires
        old(state).storage_well_formed(),
        old(state).markers.length < __TRIPTYCH_MARKER_CAPACITY__,
        search_close_capture_one(original@, key) == Some(old(state).deep_view()),
        marker.deep_view() == original@.markers.last(),
        marker.capture_count < marker.second_capture_count,
        marker.second_capture_count < original@.captures.len(),
        original@.captures[marker.capture_count as int].is_none(),
        original@.captures[marker.second_capture_count as int].is_none(),
    ensures
        final(state).deep_view() == original@,
        final(state).storage_well_formed(),
        final(state).semantic_cache == old(state).semantic_cache,
{
    proof {
        reveal(search_close_capture_one);
        assert(marker.capture_count < state.captures@.len());
    }
    search_clear_capture_exec(&mut state.captures, marker.capture_count);
    state.markers.push(marker);
    proof {
        reveal(search_close_capture_one);
        original@.markers.lemma_add_last_back();
        assert(state.captures@ =~= original@.captures);
        assert(state.markers.deep_view() =~= original@.markers);
    }
}

#[inline(always)]
fn search_reopen_capture_two_exec(
    state: &mut SearchState,
    marker: SearchMarker,
    first: CaptureKey,
    second: CaptureKey,
    original: Ghost<SearchStateSpec>,
)
    requires
        old(state).storage_well_formed(),
        old(state).markers.length < __TRIPTYCH_MARKER_CAPACITY__,
        search_close_capture_two(original@, first, second) == Some(old(state).deep_view()),
        marker.deep_view() == original@.markers.last(),
        marker.capture_count < marker.second_capture_count,
        marker.second_capture_count < original@.captures.len(),
        original@.captures[marker.capture_count as int].is_none(),
        original@.captures[marker.second_capture_count as int].is_none(),
    ensures
        final(state).deep_view() == original@,
        final(state).storage_well_formed(),
        final(state).semantic_cache == old(state).semantic_cache,
{
    proof {
        reveal(search_close_capture_two);
        assert(marker.second_capture_count < state.captures@.len());
    }
    search_clear_capture_exec(&mut state.captures, marker.second_capture_count);
    search_clear_capture_exec(&mut state.captures, marker.capture_count);
    state.markers.push(marker);
    proof {
        reveal(search_close_capture_two);
        original@.markers.lemma_add_last_back();
        assert(state.captures@ =~= original@.captures);
        assert(state.markers.deep_view() =~= original@.markers);
    }
}

#[inline(always)]
fn search_reopen_count_capture_exec(
    state: &mut SearchState,
    marker: SearchMarker,
    key: CaptureKey,
    count: usize,
    original: Ghost<SearchStateSpec>,
)
    requires
        old(state).storage_well_formed(),
        old(state).markers.length < __TRIPTYCH_MARKER_CAPACITY__,
        search_close_count_capture(original@, key, count) == Some(old(state).deep_view()),
        marker.deep_view() == original@.markers.last(),
        marker.capture_count < marker.second_capture_count,
        marker.second_capture_count < original@.captures.len(),
        original@.captures[marker.capture_count as int].is_none(),
        original@.captures[marker.second_capture_count as int].is_none(),
    ensures
        final(state).deep_view() == original@,
        final(state).storage_well_formed(),
        final(state).semantic_cache == old(state).semantic_cache,
{
    proof {
        reveal(search_close_count_capture);
        assert(marker.capture_count < state.captures@.len());
    }
    search_clear_capture_exec(&mut state.captures, marker.capture_count);
    state.markers.push(marker);
    proof {
        reveal(search_close_count_capture);
        original@.markers.lemma_add_last_back();
        assert(state.captures@ =~= original@.captures);
        assert(state.markers.deep_view() =~= original@.markers);
    }
}
