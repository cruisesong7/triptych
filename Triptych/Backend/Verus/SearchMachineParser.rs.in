#[inline(always)]
fn search_close_capture_two_exec(
    state: &mut SearchState,
    first: CaptureKey,
    second: CaptureKey,
    input_length: Ghost<nat>,
) -> (result: bool)
    requires
        search_state_bounded(old(state).deep_view(), input_length@),
        old(state).storage_well_formed(),
    ensures
        result ==> search_close_capture_two(old(state).deep_view(), first, second)
            == Some(final(state).deep_view())
            && search_state_bounded(final(state).deep_view(), input_length@)
            && final(state).storage_well_formed()
            && final(state).semantic_cache == old(state).semantic_cache,
        !result ==> search_close_capture_two(old(state).deep_view(), first, second).is_none()
            && final(state).deep_view() == old(state).deep_view()
            && final(state).storage_well_formed()
            && final(state).semantic_cache == old(state).semantic_cache,
{
    let original = Ghost(state.deep_view());
    if state.markers.len() == 0 {
        return false;
    }
    let marker = state.markers.get(state.markers.len() - 1);
    let end = state.end;
    let first_capture = RuntimeCapture {
        key: first,
        start: marker.start,
        end,
        count: 0,
        is_count: false,
    };
    let second_capture = RuntimeCapture {
        key: second,
        start: marker.start,
        end,
        count: 0,
        is_count: false,
    };
    search_set_capture_exec(
        &mut state.captures,
        marker.capture_count,
        first_capture,
    );
    search_set_capture_exec(
        &mut state.captures,
        marker.second_capture_count,
        second_capture,
    );
    state.markers.pop();
    proof {
        reveal(search_close_capture_two);
        assert(state.deep_view() == search_close_slots_state(
            original@,
            Some(first_capture),
            Some(second_capture),
        ));
        search_close_slots_state_bounded(
            original@,
            Some(first_capture),
            Some(second_capture),
            input_length@,
        );
    }
