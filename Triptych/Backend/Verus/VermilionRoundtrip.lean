import Triptych.Backend.Verus

/-!
# Vermilion semantic roundtrip guard

This module deterministically emits:

* a Verus proof-function anchor that references every generated specification function, forcing
  Vermilion to recover the complete specification rather than only transitively used definitions;
* a Lean contract whose fields compare Triptych's original readable definitions with the
  definitions recovered by Vermilion through the actual Verus front and middle end.

The contract contains no proof and introduces no axiom. A separately maintained proof module
constructs the generated class. Regeneration can therefore strengthen or change the obligations
without allowing an old proof to keep compiling against a hand-edited statement.
-/

namespace Triptych.Backend.Verus.VermilionRoundtrip

open IR

/-- Environment variable used by the CLI to request nonpersistent roundtrip artifacts. -/
def exportEnvironmentVariable : String :=
  "TRIPTYCH_VERMILION_EXPORT"

/-- Read the private artifact-export directory requested by the CLI. -/
def exportDirectoryFromEnvironment : IO (Option System.FilePath) := do
  return (← IO.getEnv exportEnvironmentVariable).map System.FilePath.mk

private def isIdentCharacter (character : Char) : Bool :=
  character.isAlphanum || character == '_'

private partial def snakeCharacters (previousWasWordEnd : Bool) : List Char → List Char
  | [] => []
  | character :: rest =>
      let uppercase := character.isUpper
      let separator := if uppercase && previousWasWordEnd then ['_'] else []
      let rendered := if isIdentCharacter character then character.toLower else '_'
      let wordEnd := character.isLower || character.isDigit
      separator ++ [rendered] ++ snakeCharacters wordEnd rest

private def sanitizeIdent (source : String) : String :=
  let cleaned := String.ofList (snakeCharacters false source.toList)
  let cleaned := if cleaned.isEmpty then "format" else cleaned
  match cleaned.front? with
  | some character => if character.isDigit then "format_" ++ cleaned else cleaned
  | none => "format"

/-- Stable Rust crate stem used for the source passed through Vermilion. -/
def crateStem (formatName : String) : String :=
  "triptych_" ++ sanitizeIdent formatName ++ "_roundtrip"

/--
Triptych-owned module name for the definitions Vermilion recovers. The runner copies Vermilion's
`generated/<crate>/Specs.lean` here, outside Vermilion's own `generated.*` namespace, so the
roundtrip Lake package can depend on Vermilion without two libraries claiming one module.
-/
def recoveredModule (formatName : String) : String :=
  "TriptychVermilionRecovered." ++ formatName

/-- Generated Lean module containing the recovered aliases and immutable obligation types. -/
def contractModule (formatName : String) : String :=
  "TriptychVermilionGenerated." ++ formatName

/-- Developer-maintained Lean module expected to prove the generated obligations. -/
def proofModule (formatName : String) : String :=
  "TriptychVermilionProofs." ++ formatName

private def verusTy : IR.Ty → String
  | .bool => "bool"
  | .int => "int"
  | .byte => "char"
  | .text => "Seq<char>"
  | .option inner => s!"Option<{verusTy inner}>"
  | .named name => name

private def anchorForFunction (function : IR.FunctionDecl) : String :=
  s!"    reveal({function.name});"

/--
A proof-only Verus anchor that reveals every generated specification function. Vermilion
registers revealed specification definitions for Lean emission, including definitions that no
other generated root happens to reference.
-/
def emitAnchor (format : FormatInput) : Except String String := do
  let module ← translateSpecToIR format
  let functions := module.declarations.filterMap fun
    | .function function => some function
    | _ => none
  if functions.isEmpty then
    throw "Vermilion roundtrip: generated specification contains no functions"
  let reveals := String.intercalate "\n" (functions.map anchorForFunction)
  let leftBrace := "{"
  let rightBrace := "}"
  pure ("\n// Generated by Triptych solely to make Vermilion recover every " ++
    "specification definition.\n" ++
    s!"verus! {leftBrace}\n" ++
    "pub proof fn triptych_vermilion_anchor()\n" ++
    "    ensures true,\n" ++
    s!"{leftBrace}\n" ++
    reveals ++ "\n" ++
    s!"{rightBrace}\n" ++
    s!"{rightBrace} // verus!\n")

private def captureOrder (format : FormatInput) : List String :=
  (format.valueExpr.captures ++
    (format.wfConstraints ++ format.valueConstraints).flatMap Constraint.captures).eraseDups

private def phaseCaptures (constraints : List Constraint) : List String :=
  (constraints.flatMap Constraint.captures).eraseDups

private structure LeanCounterpart where
  name : String
  guard : Option String := none

private def leanCounterpart? (doc : Option String) : Option LeanCounterpart := do
  let doc ← doc
  let docPrefix := "Lean counterpart: `"
  if doc.startsWith docPrefix then
    let rest := (doc.drop docPrefix.length).toString
    let name := (rest.splitOn "`").headD ""
    guard (!name.isEmpty)
    pure { name }
  else
    let guardedPrefix := "Lean counterpart under `"
    guard (doc.startsWith guardedPrefix)
    let rest := (doc.drop guardedPrefix.length).toString
    match rest.splitOn "`" with
    | guardName :: ": " :: name :: _ =>
        guard (!guardName.isEmpty && !name.isEmpty)
        pure { name, guard := some guardName }
    | _ => none

private def ensureDistinctFieldNames (fields : List (String × IR.FunctionDecl)) :
    Except String Unit := do
  let mut seen : List String := []
  for (fieldName, function) in fields do
    if seen.contains fieldName then
      throw s!"Vermilion roundtrip: generated contract field name collision at \
        `{function.name}` (`{fieldName}`)"
    seen := fieldName :: seen

private def makeBinderNames (n : Nat) : List String :=
  List.range n |>.map fun index => s!"s{index}"

private def encodeArgument (argument : String) : String :=
  s!"(encodeString {argument})"

private def application (name : String) (arguments : List String) : String :=
  if arguments.isEmpty then name else name ++ " " ++ String.intercalate " " arguments

private def quantifyStrings (variables : List String) (body : String) : String :=
  if variables.isEmpty then body
  else s!"∀ {String.intercalate " " variables} : String, {body}"

private def recoveredAlias (recoveredNamespace : String) : IR.Decl → String
  | .function function =>
      s!"  abbrev {function.name} := {recoveredNamespace}.{function.name}"
  | .constant constant =>
      s!"  abbrev {constant.name} := {recoveredNamespace}.{constant.name}"
  | .structure structureDecl =>
      s!"  abbrev {structureDecl.name} := {recoveredNamespace}.{structureDecl.name}\n\
        \n\
        \x20 abbrev mk{structureDecl.name} := \
          {recoveredNamespace}.{structureDecl.name}.{structureDecl.name}"

private def recoveredAliases (module : IR.Module) (recoveredNamespace : String) : String :=
  String.intercalate "\n\n" (module.declarations.map (recoveredAlias recoveredNamespace))

private def counterpartField (recoveredNamespace : String)
    (function : IR.FunctionDecl) : Except String (String × String) := do
  let some counterpart := leanCounterpart? function.doc
    | throw "Vermilion roundtrip: internal error: counterpart field has no counterpart"
  unless function.params.all (·.ty == .text) do
    throw s!"Vermilion roundtrip: unsupported counterpart parameter type in \
      `{counterpart.name}`"
  let variables := makeBinderNames function.params.length
  let source := application counterpart.name variables
  let recovered :=
    application (recoveredNamespace ++ "." ++ function.name) (variables.map encodeArgument)
  let rawRelation ← match function.returnType with
    | .bool => pure s!"{source} ↔ {recovered}"
    | .int => pure s!"{source} = {recovered}"
    | other =>
        throw s!"Vermilion roundtrip: unsupported counterpart return type `{verusTy other}` \
          in `{counterpart.name}`"
  let relation ← match counterpart.guard with
    | none => pure rawRelation
    | some guardName =>
        unless variables.length == 1 do
          throw s!"Vermilion roundtrip: guarded counterpart `{counterpart.name}` must have \
            exactly one text parameter"
        pure s!"{application guardName variables} → ({rawRelation})"
  pure (function.name, quantifyStrings variables relation)

private def findFunction (module : IR.Module) (name : String) :
    Except String IR.FunctionDecl := do
  for declaration in module.declarations do
    if let .function function := declaration then
      if function.name == name then
        return function
  throw s!"Vermilion roundtrip: generated function `{name}` is missing"

private def findView (module : IR.Module) (formatName : String) :
    Except String IR.StructDecl := do
  let expected := formatName ++ "View"
  for declaration in module.declarations do
    if let .structure structureDecl := declaration then
      if structureDecl.name == expected then
        return structureDecl
  throw s!"Vermilion roundtrip: generated view `{expected}` is missing"

private def makeCaptureVariables (captures : List String) : List (String × String) :=
  captures.zip (makeBinderNames captures.length)

private def lookupCapture (captureVariables : List (String × String)) (capture : String) :
    Except String String :=
  match captureVariables.find? (·.1 == capture) with
  | some (_, valueName) => pure valueName
  | none => throw s!"Vermilion roundtrip: missing variable for capture `{capture}`"

private def sourceCallForCaptures (formatName leanName : String)
    (captureVariables : List (String × String)) (captures : List String) :
    Except String String := do
  let arguments ← captures.mapM (lookupCapture captureVariables)
  pure (application (formatName ++ "." ++ leanName) arguments)

private def conjunction (propositions : List String) : String :=
  match propositions with
  | [] => "True"
  | first :: rest => rest.foldl (fun left right => s!"({left} ∧ {right})") first

private def stringLiteral (source : String) : String :=
  reprStr source

private def viewFields (format : FormatInput) (module : IR.Module)
    (recoveredNamespace : String) : Except String (List (String × String)) := do
  let view ← findView module format.name
  let captures := captureOrder format
  unless view.fields.length == captures.length + 1 do
    throw "Vermilion roundtrip: generated view fields do not match source captures"
  let captureVariables := makeCaptureVariables captures
  let input := "input"
  let constructorArguments :=
    encodeArgument input :: captureVariables.map fun (_, valueName) => encodeArgument valueName
  let recoveredView :=
    "(" ++ application
      (recoveredNamespace ++ ".mk" ++ view.name)
      constructorArguments ++ ")"
  let allVariables := input :: captureVariables.map (·.2)
  let formatPrefix := sanitizeIdent format.name
  let viewDenotation ← findFunction module (formatPrefix ++ "_view_denotation")
  let viewValid ← findFunction module (formatPrefix ++ "_view_valid")
  let matchesView ← findFunction module (formatPrefix ++ "_matches_view")
  let matchesResult ← findFunction module (formatPrefix ++ "_matches_result")
  let sourceValue ←
    sourceCallForCaptures format.name "value" captureVariables format.valueExpr.captures
  let mut sourcePhases : List String := []
  unless format.wfConstraints.isEmpty do
    sourcePhases := sourcePhases ++
      [← sourceCallForCaptures format.name "WfConstraints" captureVariables
        (phaseCaptures format.wfConstraints)]
  unless format.valueConstraints.isEmpty do
    sourcePhases := sourcePhases ++
      [← sourceCallForCaptures format.name "Constraints" captureVariables
        (phaseCaptures format.valueConstraints)]
  let sourceValid := conjunction sourcePhases
  let denotationRelation :=
    s!"{application (recoveredNamespace ++ "." ++ viewDenotation.name) [recoveredView]} = \
      {sourceValue}"
  let validRelation :=
    s!"{application (recoveredNamespace ++ "." ++ viewValid.name) [recoveredView]} ↔ \
      {sourceValid}"
  let existentialBinders := captureVariables.map (·.2)
  let matchesBody :=
    application (recoveredNamespace ++ "." ++ matchesView.name)
      [encodeArgument input, recoveredView]
  let sourceGrammar := s!"{format.name}.IsWf.{format.grammar.start} {input}"
  let sourceCaptures :=
    captureVariables.map fun (capture, valueName) =>
      s!"Triptych.component {format.name}.grammar {input} {stringLiteral capture} = {valueName}"
  let exactMatchesRelation :=
    s!"{matchesBody} ↔ {conjunction (sourceGrammar :: sourceCaptures)}"
  let arbitraryView := "view"
  let arbitraryMatchesBody :=
    application (recoveredNamespace ++ "." ++ matchesView.name)
      [encodeArgument input, arbitraryView]
  let normalizationConclusion :=
    if existentialBinders.isEmpty then
      s!"{arbitraryView} = {recoveredView}"
    else
      s!"∃ {String.intercalate " " existentialBinders} : String, \
        {arbitraryView} = {recoveredView}"
  let normalizationRelation :=
    s!"∀ input : String, ∀ {arbitraryView} : {recoveredNamespace}.{view.name}, \
      {arbitraryMatchesBody} → {normalizationConclusion}"
  let matchesRelation :=
    if existentialBinders.isEmpty then
      s!"{sourceGrammar} ↔ {matchesBody}"
    else
      s!"{sourceGrammar} ↔ ∃ \
        {String.intercalate " " existentialBinders} : String, {matchesBody}"
  let resultRelation :=
    s!"({format.name}.IsValid input ∧ {format.name}.computeValue input = some result) ↔ \
      {application (recoveredNamespace ++ "." ++ matchesResult.name)
        [encodeArgument input, "result"]}"
  pure
    [ ("view_denotation", quantifyStrings allVariables denotationRelation),
      ("view_valid", quantifyStrings allVariables validRelation),
      ("matching_view_normalizes", normalizationRelation),
      ("matches_view_exact", quantifyStrings allVariables exactMatchesRelation),
      ("matching_view_exists", s!"∀ input : String, {matchesRelation}"),
      ("matches_result", s!"∀ input : String, ∀ result : Int, {resultRelation}") ]

private def obligationFields (format : FormatInput) (module : IR.Module)
    (recoveredNamespace : String) : Except String (List (String × String)) := do
  let mut counterpartFunctions : List IR.FunctionDecl := []
  for declaration in module.declarations do
    if let .function function := declaration then
      if let some counterpart := leanCounterpart? function.doc then
        if function.params.all (·.ty == .text) then
          counterpartFunctions := counterpartFunctions ++ [function]
        else unless counterpart.name == format.name ++ ".View.denotation" do
          throw s!"Vermilion roundtrip: unsupported counterpart signature \
            `{counterpart.name}`"
  let namedCounterparts := counterpartFunctions.filterMap fun function => do
    let counterpart ← leanCounterpart? function.doc
    guard (!counterpart.name.isEmpty)
    pure (function.name, function)
  ensureDistinctFieldNames namedCounterparts
  let counterpartFields ← counterpartFunctions.mapM (counterpartField recoveredNamespace)
  let rawViewFields ← viewFields format module recoveredNamespace
  let obligations := counterpartFields ++ rawViewFields
  if obligations.isEmpty then
    throw "Vermilion roundtrip: no semantic obligations were generated"
  pure obligations

private def semanticObligations (format : FormatInput) :
    Except String (List (String × String)) := do
  let module ← translateSpecToIR format
  obligationFields format module "Recovered"

/--
Emit the immutable recovered-definition aliases used after Vermilion translates the generated
Verus specification back to Lean. Public proof files state every semantic theorem directly.
-/
def emitContract (format : FormatInput) (sourceModule : String) :
    Except String String := do
  let module ← translateSpecToIR format
  let rawRecoveredNamespace := crateStem format.name
  let aliases := recoveredAliases module rawRecoveredNamespace
  let _ ← obligationFields format module "Recovered"
  pure s!"/- Generated by Triptych. Do not edit: regenerate the roundtrip contract instead. -/\n\
    \n\
    import {sourceModule}\n\
    import {recoveredModule format.name}\n\
    import TriptychVermilionProofs.Utils\n\
    import Vermilion\n\
    \n\
    noncomputable section\n\
    \n\
    namespace Triptych.Vermilion.Generated.{format.name}\n\
    \n\
    -- Short, format-local names for the definitions recovered by Vermilion.\n\
    namespace Recovered\n\
    {aliases}\n\
    end Recovered\n\
    \n\
    end Triptych.Vermilion.Generated.{format.name}\n"

private def obligationNames (format : FormatInput) : Except String (List String) := do
  let obligations ← semanticObligations format
  pure (obligations.map (·.1))

def emitProofScaffold (format : FormatInput) : Except String String := do
  let obligations ← semanticObligations format
  let theorems := String.intercalate "\n\n" (obligations.map fun (name, proposition) =>
    s!"theorem {name} :\n    {proposition} := by\n  sorry")
  pure s!"import TriptychVermilionGenerated.{format.name}\n\
    \n\
    namespace Triptych.Vermilion.Proofs.{format.name}\n\
    \n\
    open Triptych.Vermilion.String\n\
    open Triptych.Vermilion.Generated.{format.name}\n\
    \n\
    {theorems}\n\
    \n\
    end Triptych.Vermilion.Proofs.{format.name}\n"

private def checkModule (formatName : String) : String :=
  "TriptychVermilionCheck." ++ formatName

/--
Pins the `String ↔ Vermilion.Seq Int` bridge every obligation is stated through. The bridge lives
in the developer-maintained `Utils.lean`; an edit that changes its meaning fails this check
instead of silently changing what the roundtrip theorems say.
-/
private def encodeStringPin : String :=
  "-- The bridge every obligation is stated through: one Unicode scalar value per character.\n\
  example : Triptych.Vermilion.String.encodeString =\n\
  \x20   fun source => source.toList.map (fun character => Int.ofNat character.toNat) := rfl"

def emitCheckModule (format : FormatInput) : Except String String := do
  let obligations ← semanticObligations format
  let checks := String.intercalate "\n\n" (obligations.map fun (name, proposition) =>
    let theoremName := s!"Triptych.Vermilion.Proofs.{format.name}.{name}"
    s!"example : {proposition} := {theoremName}\n\n#print axioms {theoremName}")
  pure s!"import TriptychVermilionProofs.{format.name}\n\
    \n\
    open Triptych.Vermilion.String\n\
    open Triptych.Vermilion.Generated.{format.name}\n\
    \n\
    {encodeStringPin}\n\
    \n\
    {checks}\n"

/-- Metadata written beside one temporary roundtrip artifact set. -/
def emitManifest (formatName sourceModule : String) (names : List String) : String :=
  s!"format={formatName}\n\
    crate_stem={crateStem formatName}\n\
    source_module={sourceModule}\n\
    recovered_module={recoveredModule formatName}\n\
    contract_module={contractModule formatName}\n\
    proof_module={proofModule formatName}\n\
    check_module={checkModule formatName}\n" ++
    String.join (names.map fun name => s!"obligation={name}\n")

/--
Write one temporary artifact set requested by `check-verus-roundtrip`. These files are generated
outside the source tree; the checked-in `spec.rs` remains protected by the ordinary drift guard.
-/
def exportArtifacts (root : System.FilePath) (format : FormatInput)
    (sourceModule specSource : String) : IO (Except String System.FilePath) := do
  try
    let directory := root / sanitizeIdent format.name
    IO.FS.createDirAll directory
    let generatedDirectory := directory / "TriptychVermilionGenerated"
    IO.FS.createDirAll generatedDirectory
    let anchor ← match emitAnchor format with
      | .ok source => pure source
      | .error message => return .error message
    let contract ← match emitContract format sourceModule with
      | .ok source => pure source
      | .error message => return .error message
    let proofScaffold ← match emitProofScaffold format with
      | .ok source => pure source
      | .error message => return .error message
    let checkSource ← match emitCheckModule format with
      | .ok source => pure source
      | .error message => return .error message
    let names ← match obligationNames format with
      | .ok names => pure names
      | .error message => return .error message
    IO.FS.writeFile (directory / "spec.rs") specSource
    IO.FS.writeFile (directory / s!"{crateStem format.name}.rs") (specSource ++ anchor)
    IO.FS.writeFile (generatedDirectory / s!"{format.name}.lean") contract
    IO.FS.writeFile (directory / s!"{format.name}.proof-scaffold.lean")
      proofScaffold
    let checkPath := directory / s!"{checkModule format.name |>.replace "." "/"}.lean"
    IO.FS.createDirAll (checkPath.parent.getD directory)
    IO.FS.writeFile checkPath checkSource
    IO.FS.writeFile (directory / "manifest.txt") (emitManifest format.name sourceModule names)
    return .ok directory
  catch error =>
    return .error s!"Vermilion roundtrip: unable to export artifacts: {error}"

end Triptych.Backend.Verus.VermilionRoundtrip
