+/// Benchmark-only access to Cedar's production IP address parser.
+///
+/// The tuple is `(family, address bits, prefix length)`, where family is 4 or 6.
+#[cfg(feature = "benchmark-internals")]
+#[doc(hidden)]
+pub fn benchmark_parse_ipaddr(input: &str) -> Option<(u8, u128, u8)> {
+    let parsed = IPAddr::from_str(input).ok()?;
+    match parsed.addr {
+        std::net::IpAddr::V4(address) => {
+            Some((4, u128::from(u32::from(address)), parsed.prefix))
+        }
+        std::net::IpAddr::V6(address) => Some((6, u128::from(address), parsed.prefix)),
+    }
+}
