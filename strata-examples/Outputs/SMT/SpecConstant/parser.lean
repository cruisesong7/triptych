theorem SpecConstant.computeValue_view (s : String) :
    SpecConstant.computeValue s = (SpecConstant.decodeView s).map SpecConstant.View.denotation :=
  by
  unfold SpecConstant.decodeView
  cases h : decode SpecConstant.grammar s with
  |
    none =>
    rw [show SpecConstant.computeValue s = none
        by
        rw [SpecConstant.computeValue_eq, h]
        rfl]
    rfl
  | some m =>
    rw [SpecConstant.computeValue_of_decode h]
    simp only [Option.map_some]
    rfl

