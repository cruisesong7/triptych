theorem SpecConstant.computeValue_isSome (s : String) : SpecConstant.IsValid s → (SpecConstant.computeValue s).isSome :=
  by
  intro h
  have hengine := (SpecConstant.IsValid_equiv s).mp h
  unfold Triptych.isWf at hengine
  unfold SpecConstant.computeValue Triptych.computeValueMap
  rw [Option.isSome_map]
  exact hengine.1.1

def SpecConstant.parse (s : String) :=
  Triptych.gatedParse SpecConstant.IsValid SpecConstant.computeValue s

theorem SpecConstant.parse_sound (s : String) (v : Value) :
    SpecConstant.parse s = some v → SpecConstant.IsValid s ∧ SpecConstant.computeValue s = some v :=
  Triptych.gatedParse_sound _ _ s v

theorem SpecConstant.parse_complete (s : String) (v : Value) :
    SpecConstant.IsValid s → SpecConstant.computeValue s = some v → SpecConstant.parse s = some v :=
  Triptych.gatedParse_complete _ _ s v

theorem SpecConstant.parse_reject (s : String) : SpecConstant.parse s = none ↔ ¬SpecConstant.IsValid s :=
  Triptych.gatedParse_reject _ _ SpecConstant.computeValue_isSome s

theorem SpecConstant.parse_view (s : String) :
    SpecConstant.parse s =
      if decide (SpecConstant.IsValid s) then (SpecConstant.decodeView s).map SpecConstant.View.denotation else none :=
  by
  unfold SpecConstant.parse Triptych.gatedParse
  rw [SpecConstant.computeValue_view]

theorem SpecConstant.parse_eq_some_iff_view (s : String) (v : Value) :
    SpecConstant.parse s = some v ↔
      ∃ decodedView : SpecConstant.View,
        SpecConstant.decodeView s = some decodedView ∧
          SpecConstant.View.Valid decodedView ∧ SpecConstant.View.denotation decodedView = v :=
  by
  constructor
  · intro hparse
    obtain ⟨hvalid, hvalue⟩ := SpecConstant.parse_sound s v hparse
    obtain ⟨decodedView, hview, hvalidView⟩ := (SpecConstant.IsValid_view s).mp hvalid
    refine ⟨decodedView, hview, hvalidView, ?_⟩
    rw [SpecConstant.computeValue_view, hview] at hvalue
    exact Option.some.inj hvalue
  · rintro ⟨decodedView, hview, hvalidView, hvalue⟩
    apply SpecConstant.parse_complete s v
    · exact (SpecConstant.IsValid_view s).mpr ⟨decodedView, hview, hvalidView⟩
    · rw [SpecConstant.computeValue_view, hview]
      exact congrArg some hvalue

theorem SpecConstant.parse_eq_none_iff_view (s : String) :
    SpecConstant.parse s = none ↔
      ¬∃ v : SpecConstant.View, SpecConstant.decodeView s = some v ∧ SpecConstant.View.Valid v :=
  by
  rw [SpecConstant.parse_reject]
  constructor
  · intro hinvalid ⟨v, hview, hvalidView⟩
    exact hinvalid ((SpecConstant.IsValid_view s).mpr ⟨v, hview, hvalidView⟩)
  · intro hnoview hvalid
    exact hnoview ((SpecConstant.IsValid_view s).mp hvalid)
