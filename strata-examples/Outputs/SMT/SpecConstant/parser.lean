      some
        (SpecConstant.value ((Triptych.CaptureMap.toEnv m "StringLiteral").getD "")
          ((Triptych.CaptureMap.toEnv m "Sign").getD "") ((Triptych.CaptureMap.toEnv m "Natural").getD "")
          ((Triptych.CaptureMap.toEnv m "Fraction").getD "")) :=
