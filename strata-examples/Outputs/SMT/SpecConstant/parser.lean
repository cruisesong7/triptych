theorem SpecConstant.IsWfGrammar_equiv (s : String) :
    Triptych.IsWf SpecConstant.grammar s ↔ SpecConstant.IsWf.SpecConstant s :=
  by
  rw [isWf_eq_isWfProd_start, IsWfProd,
    show
      (SpecConstant.grammar).prod? (SpecConstant.grammar).start =
        some
          (Production.mk "SpecConstant"
            [[SymItem.mk (Sym.ref "StringLiteral") false], [SymItem.mk (Sym.ref "NumericLiteral") false]])
      from rfl]
  have hstart :
    ∀ n,
      matchesProd SpecConstant.grammar n
          (Production.mk "SpecConstant"
            [[SymItem.mk (Sym.ref "StringLiteral") false], [SymItem.mk (Sym.ref "NumericLiteral") false]])
          s =
        matchesSym SpecConstant.grammar (n + 1) (Sym.ref "SpecConstant") s :=
    by
    intro n
    rw [matchesSym,
      show
        (SpecConstant.grammar).prod? "SpecConstant" =
          some
            (Production.mk "SpecConstant"
              [[SymItem.mk (Sym.ref "StringLiteral") false], [SymItem.mk (Sym.ref "NumericLiteral") false]])
        from rfl]
  show
    matchesProd SpecConstant.grammar (SpecConstant.grammar).prods.length
        (Production.mk "SpecConstant"
          [[SymItem.mk (Sym.ref "StringLiteral") false], [SymItem.mk (Sym.ref "NumericLiteral") false]])
        s ↔
      _
  rw [hstart]
  exact SpecConstant.Internal.matchesRef.SpecConstant _ s

